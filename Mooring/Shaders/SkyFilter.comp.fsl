#include "SkyFilter.srt.h"
NUM_THREADS(8, 8, 1)

void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint height = gFilter.dimensions.x;
    uint mipHeight = height >> gFilter.dimensions.y;
    uint parent = mipHeight * 2;
    if (id.x >= mipHeight * 2 || id.y >= mipHeight)
    {
        RETURN();
    }
    float4 radiance = float4(0, 0, 0, 0);
    float weight = 0;
    for (uint offsetY = 0; offsetY < 2; offsetY++)
    {
        // Lat-long texels have unequal solid angles. Without these weights,
        // tiny polar caps dominate rough reflections as the mips get coarser.
        float solidAngle = sin((float(id.y * 2 + offsetY) + .5) * 3.14159265359 / float(parent));
        for (uint offsetX = 0; offsetX < 2; offsetX++)
        {
            radiance += LoadRWTex2D(gRadiance, id.xy * 2 + uint2(offsetX, offsetY)) * solidAngle;
            weight += solidAngle;
        }
    }
    Write2D(gFiltered, id.xy, radiance / weight);
    RETURN();
}

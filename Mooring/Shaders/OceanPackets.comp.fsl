#include "Ocean.srt.h"

#define OCEAN_LOCAL_PATCH_SIZE_METERS 64
#define OCEAN_PACKET_DECAY_PER_SECOND .18
#define OCEAN_VESSEL_SOURCE_CAPACITY  16

NUM_THREADS(8, 8, 1)

void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint resolution = uint(gOcean.patch.z);
    float2 world = gOcean.patch.xy + (float2(id.xy) / float(resolution) - .5) * OCEAN_LOCAL_PATCH_SIZE_METERS;
    float3 field = float3(0, 0, 0);
    for (uint sourceIndex = 0; sourceIndex < uint(gOcean.patch.w); sourceIndex++)
    {
        float4 free = gPackets[sourceIndex * 4];
        float4 actual = gPackets[sourceIndex * 4 + 1];
        float4 directions = gPackets[sourceIndex * 4 + 2];
        float4 wave = gPackets[sourceIndex * 4 + 3];
        if (wave.w <= 0)
            continue;
        for (uint counter = 0; counter < 2; counter++)
        {
            float2 center = counter != 0 ? free.xy : actual.xy;
            float2 direction = counter != 0 ? directions.xy : directions.zw;
            float amplitude = counter != 0 ? -free.z : actual.z;
            float2 delta = world - center;
            float normalizedRadiusSquared = dot(delta, delta) / (wave.z * wave.z);
            if (normalizedRadiusSquared >= 1 || amplitude == 0)
                continue;
            float remaining = saturate(wave.w - actual.w);
            float life = remaining * remaining * (3 - 2 * remaining);
            float decay = exp(-OCEAN_PACKET_DECAY_PER_SECOND * actual.w);
            float envelope = (1 - normalizedRadiusSquared) * (1 - normalizedRadiusSquared) * decay;
            float phase = wave.x * dot(delta, direction) + free.w;
            float cosine = cos(phase);
            float sine = sin(phase);
            float2 gradient = -4 * delta / (wave.z * wave.z) * (1 - normalizedRadiusSquared) * decay;
            field +=
                amplitude * life * float3(envelope * cosine, gradient * cosine - envelope * wave.x * direction * sine);
        }
    }
    for (uint sourceIndex = 0; sourceIndex < OCEAN_VESSEL_SOURCE_CAPACITY; sourceIndex++)
    {
        uint base = (gOcean.transform.w + sourceIndex) * 4;
        float4 position = gPackets[base];
        float4 forward = gPackets[base + 1];
        float4 velocity = gPackets[base + 2];
        float4 hulls = gPackets[base + 3];
        if (position.w <= 0)
            continue;
        float2 relative = world - position.xz;
        float2 side = float2(forward.z, -forward.x);
        float along = dot(relative, forward.xz);
        float across = dot(relative, side);
        for (uint hull = 0; hull < (hulls.x > 0 ? 2u : 1u); hull++)
        {
            float cross = across + (hull == 0 ? -.5 : .5) * hulls.x;
            float width = velocity.w * .62 + .3;
            float crossFactor = exp(-cross * cross / (width * width));
            if (crossFactor < .00001)
                continue;
            for (uint term = 0; term < 3; term++)
            {
                float center = term == 0 ? .40 : term == 1 ? 0.0 : -.46;
                float span = forward.w * (term == 0 ? .105 : term == 1 ? .28 : .09);
                float offset = along - forward.w * center;
                float height = position.w *
                               (term == 0   ? 1.0
                                : term == 1 ? -.1545 / .28
                                            : .55) *
                               exp(-offset * offset / (span * span)) * crossFactor;
                float alongDerivative = -2 * offset / (span * span) * height;
                float acrossDerivative = -2 * cross / (width * width) * height;
                field += float3(height, forward.xz * alongDerivative + side * acrossDerivative);
            }
        }
    }
    float2 relative = world - gOcean.patch.xy;
    float2 transition = saturate((32 - abs(relative)) / 8);
    float2 weights = transition * transition * (3 - 2 * transition);
    float blend = weights.x * weights.y;
    float2 gradient = -6 * transition * (1 - transition) / 8 * sign(relative) * weights.yx;
    field.yz = field.yz * blend + gradient * field.x;
    field.x *= blend;
    float foam = saturate((length(field.yz) - .12) * 3);
    gDestination[id.y * resolution + id.x] = float4(field, foam);
    RETURN();
}

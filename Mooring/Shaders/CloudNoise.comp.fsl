#include "Water.srt.h"

#define CLOUD_HASH_MULTIPLIER  1664525u
#define CLOUD_HASH_INCREMENT   1013904223u
#define CLOUD_HASH_MIX_SHIFT   16u
#define CLOUD_HASH_VALUE_MASK  0x00ffffffu
#define CLOUD_HASH_VALUE_RANGE 16777216.0
#define CLOUD_NOISE_RESOLUTION 64

// Periodic noise is baked once into a 64^3 texture. Cloud marching then uses
// hardware trilinear samples instead of evaluating nested noise per ray step.
float3 cloudHash(uint3 cell)
{
    cell = CLOUD_HASH_MULTIPLIER * cell + CLOUD_HASH_INCREMENT;
    cell.x += cell.y * cell.z;
    cell.y += cell.z * cell.x;
    cell.z += cell.x * cell.y;
    cell ^= cell >> CLOUD_HASH_MIX_SHIFT;
    return float3(cell & CLOUD_HASH_VALUE_MASK) / CLOUD_HASH_VALUE_RANGE;
}

float worley(float3 coordinate, uint period)
{
    int3 cell = int3(floor(coordinate));
    float3 fraction = frac(coordinate);
    float distance = 2;
    for (int offsetZ = -1; offsetZ <= 1; offsetZ++)
        for (int offsetY = -1; offsetY <= 1; offsetY++)
            for (int offsetX = -1; offsetX <= 1; offsetX++)
            {
                int3 offset = int3(offsetX, offsetY, offsetZ);
                float3 delta = float3(offset) + cloudHash(uint3(cell + offset) & (period - 1)) - fraction;
                distance = min(distance, dot(delta, delta));
            }
    return saturate(sqrt(distance));
}

float perlin(float3 coordinate, uint period)
{
    int3 cell = int3(floor(coordinate));
    float3 fraction = frac(coordinate);
    float3 blend = fraction * fraction * fraction * (fraction * (fraction * 6 - 15) + 10);
    float value = 0;
    for (uint offsetZ = 0; offsetZ < 2; offsetZ++)
        for (uint offsetY = 0; offsetY < 2; offsetY++)
            for (uint offsetX = 0; offsetX < 2; offsetX++)
            {
                uint3 offset = uint3(offsetX, offsetY, offsetZ);
                float3 gradient = normalize(cloudHash((uint3(cell) + offset) & (period - 1)) * 2 - 1);
                float3 weight = lerp(1 - blend, blend, float3(offset));
                value += dot(gradient, fraction - float3(offset)) * weight.x * weight.y * weight.z;
            }
    return .5 + value * .7;
}
NUM_THREADS(4, 4, 4)

void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    float3 uv = (float3(id) + .5) / CLOUD_NOISE_RESOLUTION;
    // Large density lobes establish the silhouette. Smaller cells only erode
    // its boundary; baking them into base density made the whole cloud wispy.
    float billows = 1 - worley(uv * 4, 4);
    float erosion = worley(uv * 8, 8) * .65 + worley(uv * 16, 16) * .35;
    float base = lerp(perlin(uv * 2, 2), billows, .6);
    Write3D(gCloudNoiseOutput, id, float4(base, erosion, 0, 1));
    RETURN();
}

#include "Post.srt.h"
#include "WaterLighting.h.fsl"
#include "SkySampling.h.fsl"

#define ATMOSPHERE_MAX_DISTANCE_METERS        8000.0
#define ATMOSPHERE_CLEAR_EXTINCTION_PER_METER .0004
#define ATMOSPHERE_RAIN_EXTINCTION_PER_METER  .0012
#define ATMOSPHERE_SHADOW_DEPTH_BIAS          .00035
#define ATMOSPHERE_RESOLUTION_SCALE           .25
#define ATMOSPHERE_MIN_FILTER_WEIGHT          1e-10
#define FXAA_LUMINANCE_WEIGHTS                float3(.299, .587, .114)
#define FXAA_MIN_EDGE_CONTRAST                .025
#define FXAA_MIN_DIRECTION_REDUCTION          .0078125
#define FXAA_RELATIVE_EDGE_CONTRAST           .1
#define FXAA_DIRECTION_REDUCTION              .03125
#define POST_SUN_DISK_OUTER_COSINE            .999984
#define POST_SUN_DISK_INNER_COSINE            .999991
#define FXAA_MIN_SEARCH_OFFSET                float2(-8, -8)
#define FXAA_MAX_SEARCH_OFFSET                float2(8, 8)
#define POST_PASS_HDR_COPY                    0
#define POST_PASS_ATMOSPHERE                  2
#define POST_PASS_BLOOM_START                 3

STRUCT(PostFragment)
{
    DATA(float4, position, SV_Position);
    DATA(float2, uv, TEXCOORD0);
};

float3 atmosphericRays(float2 uv, float depth)
{
    if (gPost.quality.y == 0 || gPost.effects.x == 0)
        return float3(0, 0, 0);
    float3 direction = normalize(gPost.forward.xyz + gPost.right.xyz * (uv.x * 2 - 1) + gPost.up.xyz * (1 - uv.y * 2));
    // Integrate the air below the cloud layer. A 240 m cap never reached the
    // cloud shadows at a low sun angle, reducing shafts to an unoccluded glow.
    float rayLength = direction.y > .001 ? min(ATMOSPHERE_MAX_DISTANCE_METERS,
                                               max(0.0, (cloudLayer(gPost.weather.x).x - gPost.eye.y) / direction.y))
                                         : ATMOSPHERE_MAX_DISTANCE_METERS;
    if (depth > 0)
        rayLength = min(rayLength, depth / max(.1, dot(direction, gPost.forward.xyz)));
    // Quarter-resolution integration affords four times the ray samples.
    uint steps = uint(gPost.quality.y) * 4;
    float integral = 0;
    float extinction = ATMOSPHERE_CLEAR_EXTINCTION_PER_METER + gPost.weather.y * ATMOSPHERE_RAIN_EXTINCTION_PER_METER;
    float mass = 1 - exp(-extinction * rayLength);
    float jitter = hashWater(uv * gPost.screen.xy);
    for (uint sampleIndex = 0; sampleIndex < steps; sampleIndex++)
    {
        float rayDistance = -log(max(.0001, 1 - (float(sampleIndex) + jitter) / float(steps) * mass)) / extinction;
        float3 world = gPost.eye.xyz + direction * rayDistance;
        float4 shadowClip = mul(gPost.shadowMatrix, float4(world, 1));
        float2 shadowUV = shadowClip.xy * float2(.5, -.5) + .5;
        float visibility = 1;
        if (all(shadowUV > 0) && all(shadowUV < 1))
            visibility = shadowClip.z - ATMOSPHERE_SHADOW_DEPTH_BIAS <=
                                 SampleLvlTex2D(gPostShadow, gSamplerPointClamp, shadowUV, 0).r
                             ? 1.0
                             : 0.0;
        integral +=
            visibility *
            cloudShadow(world, gPost.weather.x, gPost.screen.w, rayDistance * 2 / gPost.screen.y, gPost.sun.xyz) *
            mass / float(steps);
    }
    return float3(1, .87, .64) * integral * waterPhase(dot(direction, gPost.sun.xyz), .7) * gPost.effects.x *
           sunTransmission(gPost.weather.x);
}

float3 bloomColor(float2 uv)
{
    float3 bloom = float3(0, 0, 0);
    if (gPost.bloom.x > 0)
    {
        bloom = SampleLvlTex2D(gBloomNear, gSceneSampler, uv, 0).rgb * .6;
        bloom += SampleLvlTex2D(gBloomMiddle, gSceneSampler, uv, 0).rgb * .3;
        bloom += SampleLvlTex2D(gBloomFar, gSceneSampler, uv, 0).rgb * .1;
    }
    return bloom * gPost.bloom.x;
}

float3 postColor(float2 uv, float3 lighting)
{
    float3 color = SampleLvlTex2D(gSceneColor, gSceneSampler, uv, 0).rgb;
    if (gPost.effects.w > WATER_DEBUG_FINAL)
        return color;
    return filmicWater(color * gPost.effects.y + lighting);
}

float3 bloomSample(float2 uv)
{
    float3 color = SampleLvlTex2D(gSceneColor, gSceneSampler, uv, 0).rgb;
    if (gPost.screen.z == POST_PASS_BLOOM_START)
    {
        color *= gPost.effects.y;
        float brightness = max(color.r, max(color.g, color.b));
        float knee = max(.01, gPost.bloom.y * .5);
        float soft = clamp(brightness - gPost.bloom.y + knee, 0.0, 2 * knee);
        soft = soft * soft / (4 * knee);
        color *= max(soft, brightness - gPost.bloom.y) / max(.0001, brightness);
    }
    return color;
}

float3 filteredAirRays(float2 uv, float depth)
{
    if (gPost.quality.y == 0 || gPost.effects.x == 0 ||
        (gPost.effects.w > WATER_DEBUG_FINAL && gPost.effects.w != WATER_DEBUG_ATMOSPHERIC_RAYS))
        return float3(0, 0, 0);
    float2 size = ceil(gPost.screen.xy * ATMOSPHERE_RESOLUTION_SCALE);
    float2 pixel = uv * size - .5;
    float2 base = floor(pixel);
    float3 sum = float3(0, 0, 0);
    float weights = 0;
    // Tent filtering suppresses integration noise. View depth keeps light on
    // its side of a hull silhouette instead of leaking through the foreground.
    for (int offsetY = -1; offsetY <= 2; offsetY++)
        for (int offsetX = -1; offsetX <= 2; offsetX++)
        {
            float2 at = base + float2(offsetX, offsetY);
            float2 distance = abs(at - pixel);
            float4 sample = SampleLvlTex2D(gAirRays, gSamplerPointClamp, (at + .5) / size, 0);
            if ((sample.a == 0) != (depth == 0))
                continue;
            float weight = (2 - distance.x) * (2 - distance.y) * exp(-abs(sample.a - depth) / max(.3, depth * .03));
            sum += sample.rgb * weight;
            weights += weight;
        }
    // A steep horizon can have no matching coarse depth. Trace that rare
    // pixel directly instead of leaving a black line at the water boundary.
    return weights > ATMOSPHERE_MIN_FILTER_WEIGHT ? sum / weights : atmosphericRays(uv, depth);
}

float4 PS_MAIN(PostFragment input)
{
    INIT_MAIN;
    if (gPost.screen.z >= POST_PASS_BLOOM_START)
    {
        // Normalized 13-tap downsample: retain small highlights without
        // assigning all their energy to a single coarse texel.
        float2 bloomTexelSize = gPost.bloom.zw;
        float3 result = bloomSample(input.uv) * .125;
        for (int offsetY = -1; offsetY <= 1; offsetY += 2)
            for (int offsetX = -1; offsetX <= 1; offsetX += 2)
            {
                result += bloomSample(input.uv + float2(offsetX, offsetY) * bloomTexelSize) * .125;
                result += bloomSample(input.uv + float2(offsetX, offsetY) * bloomTexelSize * 2) * .03125;
            }
        for (int side = -1; side <= 1; side += 2)
        {
            result += bloomSample(input.uv + float2(side * 2, 0) * bloomTexelSize) * .0625;
            result += bloomSample(input.uv + float2(0, side * 2) * bloomTexelSize) * .0625;
        }
        RETURN(float4(result, 0));
    }
    if (gPost.screen.z == POST_PASS_HDR_COPY)
    {
        float4 scene = SampleLvlTex2D(gSceneColor, gSceneSampler, input.uv, 0);
        if (scene.a != 0)
        {
            RETURN(float4(scene.rgb, abs(scene.a)));
        }
        float3 direction =
            normalize(gPost.forward.xyz + gPost.right.xyz * (input.uv.x * 2 - 1) + gPost.up.xyz * (1 - input.uv.y * 2));
        float4 environment = sampleSky(direction, uint(gPost.forward.w));
        float3 sky = environment.rgb + float3(1, .77, .42) *
                                           smoothstep(POST_SUN_DISK_OUTER_COSINE, POST_SUN_DISK_INNER_COSINE,
                                                      dot(direction, gPost.sun.xyz)) *
                                           6 * sunTransmission(gPost.weather.x) * (1 - environment.a);
        if (gPost.effects.w > WATER_DEBUG_FINAL && gPost.effects.w != WATER_DEBUG_BLOOM)
            sky = float3(0, 0, 0);
        RETURN(float4(sky, 0));
    }
    // FXAA in display-referred linear light; UI is drawn after this pass.
    float2 pixel = 1 / gPost.screen.xy;
    float depth = SampleLvlTex2D(gSceneColor, gSamplerPointClamp, input.uv, 0).a;
    if (gPost.screen.z == POST_PASS_ATMOSPHERE)
    {
        RETURN(float4(atmosphericRays(input.uv, depth), depth));
    }
    if (gPost.effects.w == WATER_DEBUG_CLOUD_NOISE)
    {
        float2 noise = SampleLvlTex3D(gCloudNoiseTexture, gSamplerTrilinearWrap, float3(input.uv, .37), 0).rg;
        RETURN(float4(noise, 0, 1));
    }
    if (gPost.effects.w == WATER_DEBUG_CLOUD_DENSITY)
    {
        float3 world = float3((input.uv.x - .5) * 10000, (1 - input.uv.y) * 4000, 0);
        float density = cloudDensity(world, gPost.weather.x, gPost.screen.w, 0);
        RETURN(float4(density, density, density, 1));
    }
    float3 rays = filteredAirRays(input.uv, depth);
    if (gPost.effects.w == WATER_DEBUG_SKY_RADIANCE || gPost.effects.w == WATER_DEBUG_SKY_CLOUD_OPACITY)
    {
        float3 direction =
            normalize(gPost.forward.xyz + gPost.right.xyz * (input.uv.x * 2 - 1) + gPost.up.xyz * (1 - input.uv.y * 2));
        float4 environment = sampleSky(direction, uint(gPost.forward.w));
        RETURN(float4(gPost.effects.w == WATER_DEBUG_SKY_RADIANCE ? environment.rgb : float3(environment.a, environment.a, environment.a), 1));
    }
    if (gPost.effects.w == WATER_DEBUG_ATMOSPHERIC_RAYS)
    {
        RETURN(float4(rays * 6, 1));
    }
    if (gPost.effects.w == WATER_DEBUG_BLOOM)
    {
        RETURN(float4(filmicWater(bloomColor(input.uv)), 1));
    }
    // Coarse lighting is smooth across the short FXAA search. Reuse it for
    // every tap instead of fetching the three bloom levels nine times.
    float3 lighting = rays * gPost.effects.y + bloomColor(input.uv);
    float3 centerColor = postColor(input.uv, lighting);
    if (gPost.effects.w > WATER_DEBUG_FINAL || gPost.quality.w == 0)
    {
        RETURN(float4(centerColor, 1));
    }

    // Estimate edge contrast and choose the FXAA filter direction.
    float3 northwestColor = postColor(input.uv - pixel, lighting);
    float3 northeastColor = postColor(input.uv + pixel * float2(1, -1), lighting);
    float3 southwestColor = postColor(input.uv + pixel * float2(-1, 1), lighting);
    float3 southeastColor = postColor(input.uv + pixel, lighting);
    float3 luminanceWeights = FXAA_LUMINANCE_WEIGHTS;
    float northwestLuma = dot(northwestColor, luminanceWeights);
    float northeastLuma = dot(northeastColor, luminanceWeights);
    float southwestLuma = dot(southwestColor, luminanceWeights);
    float southeastLuma = dot(southeastColor, luminanceWeights);
    float centerLuma = dot(centerColor, luminanceWeights);
    float low = min(centerLuma, min(min(northwestLuma, northeastLuma), min(southwestLuma, southeastLuma)));
    float high = max(centerLuma, max(max(northwestLuma, northeastLuma), max(southwestLuma, southeastLuma)));
    if (high - low < max(FXAA_MIN_EDGE_CONTRAST, high * FXAA_RELATIVE_EDGE_CONTRAST))
    {
        RETURN(float4(centerColor, 1));
    }
    float2 direction = float2(-((northwestLuma + northeastLuma) - (southwestLuma + southeastLuma)),
                              (northwestLuma + southwestLuma) - (northeastLuma + southeastLuma));
    float reduce = max((northwestLuma + northeastLuma + southwestLuma + southeastLuma) * FXAA_DIRECTION_REDUCTION,
                       FXAA_MIN_DIRECTION_REDUCTION);
    direction = clamp(direction / (min(abs(direction.x), abs(direction.y)) + reduce), FXAA_MIN_SEARCH_OFFSET,
                      FXAA_MAX_SEARCH_OFFSET) *
                pixel;
    float3 innerA = postColor(input.uv - direction / 6, lighting);
    float3 innerB = postColor(input.uv + direction / 6, lighting);
    float3 inner = (innerA + innerB) * .5;
    float3 outerA = postColor(input.uv - direction * .5, lighting);
    float3 outerB = postColor(input.uv + direction * .5, lighting);
    float3 outer = inner * .5 + (outerA + outerB) * .25;
    float filteredLuma = dot(outer, luminanceWeights);
    RETURN(float4(filteredLuma<low || filteredLuma> high ? inner : outer, 1));
}

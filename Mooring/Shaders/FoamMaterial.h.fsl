#define FOAM_SECONDARY_LACE_SCALE      float2(-2.73, 2.73)
#define FOAM_SECONDARY_LACE_OFFSET     .37
#define FOAM_WARP_FREQUENCY            .22
#define FOAM_WARP_NOISE_OFFSET         19.1
#define FOAM_LACE_FREQUENCY            .18
#define FOAM_ADVECTION_PERIOD_SECONDS  4
#define FOAM_ADVECTION_PHASE_FREQUENCY .11
#define FOAM_MAX_ADVECTION_DISTANCE    .66
#define FOAM_GRAIN_FREQUENCY           12
#define FOAM_CLUSTER_FREQUENCY         .27
#define FOAM_AGED_COLOR                float3(.65, .79, .76)
#define FOAM_FRESH_COLOR               float3(.88, .94, .89)

#ifndef MOORING_FOAM_MATERIAL
#define MOORING_FOAM_MATERIAL

// Shared material coordinates keep adjacent sheets continuous. Particle UVs
// shape a parcel's boundary; they must not rotate or stretch its bubble field.
float2 foamStructure(float2 coordinate)
{
    float primaryLace =
        SampleGradTex2D(gFoamTexture, gSamplerTrilinearMirror, coordinate, ddx(coordinate), ddy(coordinate)).r;
    float2 secondaryCoordinate = coordinate * FOAM_SECONDARY_LACE_SCALE + FOAM_SECONDARY_LACE_OFFSET;
    float secondaryLace = SampleGradTex2D(gFoamTexture, gSamplerTrilinearMirror, secondaryCoordinate,
                                          ddx(secondaryCoordinate), ddy(secondaryCoordinate))
                              .r;
    return float2(primaryLace * .85 + secondaryLace * .15, secondaryLace);
}

float4 foamPattern(float2 coordinate, float2 velocity, float2 slope)
{
    float2 material = coordinate - gWater.current.xz * gWater.screen.z;
    float2 drift = material * gWater.detail.w;
    float2 warp = float2(waterNoise(drift * FOAM_WARP_FREQUENCY),
                         waterNoise(drift * FOAM_WARP_FREQUENCY + FOAM_WARP_NOISE_OFFSET)) -
                  .5;
    float2 uv = (drift + warp * .8) * FOAM_LACE_FREQUENCY;
    // Reset each advection phase only at zero weight. Surface foam and raised
    // parcels share this flow, so their texture cannot slide through each other.
    float phase =
        frac(gWater.screen.z / FOAM_ADVECTION_PERIOD_SECONDS + waterNoise(drift * FOAM_ADVECTION_PHASE_FREQUENCY) * .4);
    float2 flow =
        (velocity - gWater.current.xz) * gWater.detail.w * FOAM_LACE_FREQUENCY * FOAM_ADVECTION_PERIOD_SECONDS;
    flow *= min(1.0, FOAM_MAX_ADVECTION_DISTANCE / max(.001, length(flow)));
    float2 firstPhaseCoordinate = uv - flow * (phase - .5);
    float2 secondPhaseCoordinate = uv - flow * (frac(phase + .5) - .5);
    float blend = abs(phase * 2 - 1);
    float2 structure = lerp(foamStructure(firstPhaseCoordinate), foamStructure(secondPhaseCoordinate), blend);
    float patch = lerp(waterNoise(firstPhaseCoordinate * .8 - slope * .45),
                       waterNoise(secondPhaseCoordinate * .8 - slope * .45), blend);
    float2 grainUV = material * FOAM_GRAIN_FREQUENCY + warp * 2;
    float footprint = max(length(ddx(grainUV)), length(ddy(grainUV)));
    float grain = lerp(waterNoise(grainUV), .5, smoothstep(.35, 1.0, footprint));
    // Fresh foam keeps clustered relief after its finest bubbles disappear
    // below a pixel. Each scale converges to its mean independently.
    float clusters = lerp(waterNoise(grainUV * FOAM_CLUSTER_FREQUENCY), .5,
                          smoothstep(.35, 1.0, footprint * FOAM_CLUSTER_FREQUENCY));
    grain = clusters * .65 + grain * .35;
    return float4(structure, patch, grain);
}

float foamChurn(float density, float4 pattern)
{
    // Fresh mass fills connected foam structures while their pores retain
    // water transmission. The same thickness serves the surface and crowns.
    float thickness = .25 + 4 * pattern.x + 1.2 * pattern.w * pattern.w;
    return (1 - exp(-density * thickness)) * (.65 + .35 * pattern.w);
}

float3 shadeFoam(float3 normal, float fresh, float detail, float shadow)
{
    float light = .32 + .28 * normal.y + .6 * saturate(dot(normal, gWater.sun.xyz)) * (.35 + .65 * shadow);
    return lerp(FOAM_AGED_COLOR, FOAM_FRESH_COLOR, fresh) * light * (.72 + .28 * detail);
}
#endif

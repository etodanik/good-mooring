#include "Ocean.srt.h"
// First and second slope moments preserve unresolved wave energy in the BRDF.
// Each level contains all four bands; levels occupy disjoint buffer ranges.
NUM_THREADS(8, 8, 1)

void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint fullResolution = gOcean.transform.x;
    uint mipResolution = fullResolution >> gOcean.transform.y;
    if (id.x >= mipResolution || id.y >= mipResolution)
    {
        RETURN();
    }
    uint parent = mipResolution * 2;
    uint source = 16 * ((fullResolution * fullResolution - parent * parent) / 3) + id.z * parent * parent;
    uint destination = 16 * ((fullResolution * fullResolution - mipResolution * mipResolution) / 3) +
                       id.z * mipResolution * mipResolution + id.y * mipResolution + id.x;
    float4 surface = float4(0, 0, 0, 0);
    float4 moments = float4(0, 0, 0, 0);
    float4 whitewater = float4(0, 0, 0, 0);
    bool breakingBand = id.z == 0 || id.z == 2;
    uint whitewaterSource =
        8 * ((fullResolution * fullResolution - parent * parent) / 3) + (id.z / 2) * parent * parent;
    for (uint offsetY = 0; offsetY < 2; offsetY++)
        for (uint offsetX = 0; offsetX < 2; offsetX++)
        {
            uint sourceIndex = source + (id.y * 2 + offsetY) * parent + id.x * 2 + offsetX;
            surface += gSource[sourceIndex];
            moments += gNormals[sourceIndex];
            if (breakingBand)
                whitewater +=
                    float4(gWhitewaterOutput[whitewaterSource + (id.y * 2 + offsetY) * parent + id.x * 2 + offsetX]);
        }
    gDestination[destination] = surface * .25;
    gNormals[destination] = moments * .25;
    if (breakingBand)
    {
        uint at = 8 * ((fullResolution * fullResolution - mipResolution * mipResolution) / 3) +
                  (id.z / 2) * mipResolution * mipResolution + id.y * mipResolution + id.x;
        gWhitewaterOutput[at] = min16float4(whitewater * .25);
    }
    RETURN();
}

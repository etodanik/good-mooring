#include "Ocean.srt.h"

#define OCEAN_SPECTRUM_HALF_SUPPORT 64
#define OCEAN_SPECTRUM_SUPPORT      128
#define OCEAN_TAU                   6.28318530718
#define OCEAN_MIN_RELATIVE_DEPTH    .0001
#define OCEAN_MAX_RELATIVE_DEPTH    10.0

#define MULTIPLY_COMPLEX(left, right) \
    float2((left).x*(right).x - (left).y * (right).y, (left).x * (right).y + (left).y * (right).x)
NUM_THREADS(8, 8, 1)

void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint resolution = gOcean.transform.x;
    int2 waveMode = int2(id.xy);
    waveMode -= int2(waveMode.x >= int(resolution / 2) ? int(resolution) : 0,
                     waveMode.y >= int(resolution / 2) ? int(resolution) : 0);
    uint index = id.z * resolution * resolution + id.y * resolution + id.x;
    float4 output = float4(0, 0, 0, 0);
    if (abs(waveMode.x) < OCEAN_SPECTRUM_HALF_SUPPORT && abs(waveMode.y) < OCEAN_SPECTRUM_HALF_SUPPORT)
    {
        uint2 coord = uint2((waveMode + OCEAN_SPECTRUM_SUPPORT) % OCEAN_SPECTRUM_SUPPORT);
        uint2 opposite = uint2((-waveMode + OCEAN_SPECTRUM_SUPPORT) % OCEAN_SPECTRUM_SUPPORT);
        float4 spectrum = gSpectrum[id.z * OCEAN_SPECTRUM_SUPPORT * OCEAN_SPECTRUM_SUPPORT +
                                    coord.y * OCEAN_SPECTRUM_SUPPORT + coord.x];
        float4 oppositeSpectrum = gSpectrum[id.z * OCEAN_SPECTRUM_SUPPORT * OCEAN_SPECTRUM_SUPPORT +
                                            opposite.y * OCEAN_SPECTRUM_SUPPORT + opposite.x];
        float phase = spectrum.z * gOcean.clockDepth.x;
        float2 phaseRotation = float2(cos(phase), -sin(phase));
        float2 heightSpectrum = MULTIPLY_COMPLEX(spectrum.xy, phaseRotation) +
                                MULTIPLY_COMPLEX(float2(oppositeSpectrum.x, -oppositeSpectrum.y),
                                                 float2(phaseRotation.x, -phaseRotation.y));
        float advection =
            dot(float2(waveMode), gOcean.current.xz) * OCEAN_TAU / gOcean.lengths[id.z] * gOcean.clockDepth.x;
        heightSpectrum = MULTIPLY_COMPLEX(heightSpectrum, float2(cos(advection), -sin(advection)));
        // Clamp the deep-water limit before fast-math tanh: large kh can
        // otherwise become inf/inf on Metal and poison an entire FFT band.
        float relativeDepth =
            clamp(spectrum.w * gOcean.clockDepth.z, OCEAN_MIN_RELATIVE_DEPTH, OCEAN_MAX_RELATIVE_DEPTH);
        float factor =
            spectrum.w > 0 ? OCEAN_TAU / gOcean.lengths[id.z] / max(spectrum.w, .000001) / tanh(relativeDepth) : 0;
        float2 displacementX = float2(-heightSpectrum.y, heightSpectrum.x) * float(waveMode.x) * factor;
        float2 displacementZ = float2(-heightSpectrum.y, heightSpectrum.x) * float(waveMode.y) * factor;
        output = float4(heightSpectrum, displacementX + float2(-displacementZ.y, displacementZ.x));
    }
    gDestination[index] = output;
    RETURN();
}

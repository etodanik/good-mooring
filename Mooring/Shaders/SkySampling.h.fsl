// The persistent environment is shared by sky, reflections and distance haze.
float2 skyPixel(float3 direction, uint height)
{
    float2 uv = float2(atan2(direction.z, direction.x) / 6.28318530718 + .5,
                       acos(clamp(direction.y, -1.0, 1.0)) / 3.14159265359);
    return uv * float2(height * 2, height) - .5;
}

float4 sampleSkyLevel(float3 direction, uint fullHeight, uint mip)
{
    uint height = fullHeight >> mip;
    float2 pixel = skyPixel(direction, height);
    pixel.y = clamp(pixel.y, 0.0, float(height - 1));
    return SampleLvlTex2D(gSkyRadiance, gSamplerBilinearWrap, (pixel + .5) / float2(height * 2, height), mip);
}

float4 skyCubicWeights(float fraction)
{
    float fractionSquared = fraction * fraction;
    float fractionCubed = fractionSquared * fraction;
    return float4(1 - 3 * fraction + 3 * fractionSquared - fractionCubed, 4 - 6 * fractionSquared + 3 * fractionCubed,
                  1 + 3 * fraction + 3 * fractionSquared - 3 * fractionCubed, fractionCubed) /
           6;
}

float4 sampleSky(float3 direction, uint height)
{
    // Positive cubic weights remove magnified cache cells without ringing
    // around bright cloud edges or inventing negative radiance.
    float2 pixel = skyPixel(direction, height);
    float2 base = floor(pixel) - 1;
    float4 weightsX = skyCubicWeights(frac(pixel.x));
    float4 weightsY = skyCubicWeights(frac(pixel.y));
    // Pair positive B-spline weights into four hardware bilinear fetches
    // (Sigg/Hadwiger). Longitude wraps; latitude clamps at the pole texels.
    float2 pairWeightsX = weightsX.xz + weightsX.yw;
    float2 pairWeightsY = weightsY.xz + weightsY.yw;
    float2 sampleU = (base.x + float2(0, 2) + weightsX.yw / pairWeightsX + .5) / float(height * 2);
    float2 sampleV =
        (clamp(base.y + float2(0, 2) + weightsY.yw / pairWeightsY, 0.0, float(height - 1)) + .5) / float(height);
    float4 upperLeft = SampleLvlTex2D(gSkyRadiance, gSamplerBilinearWrap, float2(sampleU.x, sampleV.x), 0);
    float4 upperRight = SampleLvlTex2D(gSkyRadiance, gSamplerBilinearWrap, float2(sampleU.y, sampleV.x), 0);
    float4 lowerLeft = SampleLvlTex2D(gSkyRadiance, gSamplerBilinearWrap, float2(sampleU.x, sampleV.y), 0);
    float4 lowerRight = SampleLvlTex2D(gSkyRadiance, gSamplerBilinearWrap, float2(sampleU.y, sampleV.y), 0);
    return (upperLeft * pairWeightsX.x + upperRight * pairWeightsX.y) * pairWeightsY.x +
           (lowerLeft * pairWeightsX.x + lowerRight * pairWeightsX.y) * pairWeightsY.y;
}

float3 sampleRoughSky(float3 direction, uint height, float slopeVariance)
{
    // Reflecting a normal doubles its angular spread. The same unresolved
    // slope variance broadens both the sun BRDF and environment reflection.
    float angle = 2 * sqrt(slopeVariance);
    float lod = clamp(log2(max(1.0, angle * float(height) / 3.14159265359)), 0.0, log2(float(height)));
    uint lowerMip = uint(floor(lod));
    uint upperMip = min(lowerMip + 1, uint(log2(float(height))));
    return lerp(sampleSkyLevel(direction, height, lowerMip).rgb, sampleSkyLevel(direction, height, upperMip).rgb,
                frac(lod));
}

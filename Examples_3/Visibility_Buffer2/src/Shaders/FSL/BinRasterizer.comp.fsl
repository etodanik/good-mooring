#include "../../../../../Common_3/Graphics/ShaderUtilities.h.fsl"
#include "../../../../../Common_3/Renderer/VisibilityBuffer2/Shaders/FSL/VisibilityBufferShadingUtilities.h.fsl"
#include "ShaderDefs.h.fsl"
#include "../../../../../Common_3/Renderer/VisibilityBuffer2/Shaders/FSL/TriangleBinning.h.fsl"

#include "VisibilityBufferResources.h.fsl"
#include "TriangleFiltering.srt.h"

#if defined(METAL) || defined(ORBIS) || defined(PROSPERO)
#define BINDLESS_SET UPDATE_FREQ_NONE
#else
#define BINDLESS_SET space4
#endif

#define LoadVertex(I) float4(asfloat(LoadByte4(gVertexPositionBuffer, (I) * 12)).xyz, 1.0f)

/* -- idea --
* loop over chunks of 256 (16x16) triangles
*   - each thread loads a triangle
*   - loop over 64x64 vb sub-tile (quarter tile)
*       - for each quad: raster into groupshared
*           - could further bypass using wave intrinsics (for later)
*       - flush the sub-tile back to memory
*       - 64*64 / 256 == 16 pixels per thread
*   - repeat until no triangles left in tile
*/

bool WaveAllEqual(uint x, bool fallback)
{
#ifdef DIRECT3D12
    return WaveActiveAllEqual(x);
#else
    return fallback;
#endif
}

bool ValidTriangle(uint triangleData)
{
#if defined(SEPARATE_ALPHA_TEST)

#if defined(ALPHA_TESTING)
    return INVALID_TRIANGLE_DATA != triangleData && GetGeomSetFromTriData(triangleData) == 1;
#else
    return INVALID_TRIANGLE_DATA != triangleData && GetGeomSetFromTriData(triangleData) != 1;
#endif

#else
    return INVALID_TRIANGLE_DATA != triangleData;
#endif
}

// each thread responsible for 1 triangle +  (4x4 pixels)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(BIN_RASTER_THREADS_X, BIN_RASTER_THREADS_Y, BIN_RASTER_THREADS_Z)
void CS_MAIN(SV_GroupThreadID(uint3) threadId, SV_GroupID(uint3) groupId)
{
    INIT_MAIN;

    float2 viewportSize       = float2(gRenderTargetInfo.width, gRenderTargetInfo.height);
    uint3  dispatchDimensions = uint3((uint2(uint(gRenderTargetInfo.width), uint(gRenderTargetInfo.height)) + BIN_SIZE - 1) / BIN_SIZE, 
                                      gRenderTargetInfo.view == VIEW_SHADOW ? 8u : 64u);

    uint  globalGroupIdx    = groupId.x + groupId.y * dispatchDimensions.x + groupId.z * dispatchDimensions.x * dispatchDimensions.y;
    uint  linearBinIndex    = globalGroupIdx % (dispatchDimensions.x * dispatchDimensions.y * SUB_BINS) / SUB_BINS;
    uint2 binIndex          = uint2(linearBinIndex % dispatchDimensions.x, linearBinIndex / dispatchDimensions.x);
    uint  subBinLinearIndex = globalGroupIdx % SUB_BINS;
    uint2 subBinIndex       = uint2(subBinLinearIndex % SUB_BINS_X, subBinLinearIndex / SUB_BINS_X);
    uint2 binCoord          = BIN_SIZE * binIndex + uint2(SUB_BIN_SIZE_X, SUB_BIN_SIZE_Y) * subBinIndex;

    uint binGroupOffset = (globalGroupIdx / (dispatchDimensions.x * dispatchDimensions.y * SUB_BINS)) * BIN_RASTER_GROUP_SIZE;
    uint binOffset      = binGroupOffset + (threadId.x + threadId.y * BIN_RASTER_THREADS_X + threadId.z * BIN_RASTER_GROUP_STRIDE);

    // load triangle data
#if defined(SEPARATE_ALPHA_TEST) && defined(ALPHA_TESTING)
    uint triangleData = GetTriangleDataAt(gRenderTargetInfo.view + NUM_CULLING_VIEWPORTS, gBinBuffer, binIndex.x, binIndex.y, binOffset);
#else
    uint triangleData = GetTriangleDataAt(gRenderTargetInfo.view, gBinBuffer, binIndex.x, binIndex.y, binOffset);
#endif

    if (ValidTriangle(triangleData)) // mechanism that is rejecting large scale triangles
    {
        uint triangleIndex = GetTriIndexFromTriData(triangleData);

        uint indices[3] = {
            LoadByte(gIndexDataBuffer, (triangleIndex * 3 + 0) << 2),
            LoadByte(gIndexDataBuffer, (triangleIndex * 3 + 1) << 2),
            LoadByte(gIndexDataBuffer, (triangleIndex * 3 + 2) << 2),
        };

        float4 vertices[3] = { LoadVertex(indices[0]), LoadVertex(indices[1]), LoadVertex(indices[2]) };
        float4x4 mvp = gComputeVBViewConstants.transform[gRenderTargetInfo.view].mvp;

        // Compute edge functions, homogenous representation
        for (int i = 0; i < 3; ++i)
        {
            vertices[i] = mul(mvp, vertices[i]);
            // To raster space (2DH)

            vertices[i] = float4(
                gRenderTargetInfo.width *  (vertices[i].x + vertices[i].w) * 0.5, 
                gRenderTargetInfo.height * (vertices[i].w - vertices[i].y) * 0.5,
                vertices[i].z, 
                vertices[i].w);
        
            vertices[i].xy = round(vertices[i].xy * 256.0f) / 256.0f; // snap
            
        }

        // M will store the three edge functions of the triangle
        float3x3 M = make_f3x3_rows(vertices[0].xyw, vertices[1].xyw, vertices[2].xyw);
        M = f3x3Inverse(M); 

        // Interpolate z/w
        float3 zInterp = mul(M, float3(vertices[0].z, vertices[1].z, vertices[2].z));


#if !defined(SEPARATE_ALPHA_TEST) || defined(ALPHA_TESTING)
        float3 uInterp;
        float3 vInterp;
        float lod;
        if (GetGeomSetFromTriData(triangleData) == 1)
        {
            float2 uvs[3];
            uvs[0] = unpack2Floats(LoadByte(gVertexTexCoordBuffer, indices[0] << 2));
            uvs[1] = unpack2Floats(LoadByte(gVertexTexCoordBuffer, indices[1] << 2));
            uvs[2] = unpack2Floats(LoadByte(gVertexTexCoordBuffer, indices[2] << 2));
            uInterp = mul(M, float3(uvs[0].x, uvs[1].x, uvs[2].x));
            vInterp = mul(M, float3(uvs[0].y, uvs[1].y, uvs[2].y));

            float d = max(dot(uInterp, uInterp), dot(vInterp, vInterp));
            float lod = log2(d)*2;
        }

        // Interpolate 1/w = M * (1, 1, 1)
        float3 wInterp = float3(f3Sum(getRow0(M)), f3Sum(getRow1(M)), f3Sum(getRow2(M))); 
#endif

// Alternatives:
// -fixed point rep, with existing inverse M (costly, vgpr concern)
// -direct edge function computation using fp
//      (instead of inverse Mat, adds overhead and defeats point of advantages of 2d homogenous rasterization)
// -pixel snapping the dot product 
//      needs 3 additional round statements to accomplish same goal as epsilon, compares against 0.0f
//      slightly more artifacting

#if defined(EPSILON_VISIBILITY_CHECK)
            float check = -0.00002f; // a small negative epsilon for the inside triangle check
#else
            float check = 0.0f;
#endif 

       // Pixel processing
        LOOP
        for(uint y = 0; y < SUB_BIN_SIZE_Y && WaveAllEqual(y, true); ++y)
        {
        
        LOOP
            for (uint x = 0; x < SUB_BIN_SIZE_X && WaveAllEqual(x, true); ++x)
            {
            
                float3 vbCoords = float3(float2(binCoord) + float2(x + 0.5f, y + 0.5f), 1.0f); // pixel center computation
                bool visible = AllLessThan(uint2(vbCoords.xy), uint2(viewportSize)); // if pixel center in the viewport

                // If the pixel center point is inside all three triangle edges, it's inside the triangle (dot >= 0)
                #ifdef DIRECT3D12
                    // Slightly faster with D3D12 (RDNA3) but doesn't compile for Vulkan
                    visible =  visible & (dot(getCol0(M), vbCoords) >= check && 
                                          dot(getCol1(M), vbCoords) >= check && 
                                          dot(getCol2(M), vbCoords) >= check);
                #else             
                    visible = visible && (dot(getCol0(M), vbCoords) >= check && 
                                          dot(getCol1(M), vbCoords) >= check && 
                                          dot(getCol2(M), vbCoords) >= check);
                #endif

#if !defined(SEPARATE_ALPHA_TEST) || defined(ALPHA_TESTING)
                if (visible && GetGeomSetFromTriData(triangleData) == 1) // needs alpha testing
                {
                    float4 diffuseColor;

                    float w = 1.0f / ((wInterp.x * vbCoords.x) + (wInterp.y * vbCoords.y) + wInterp.z);

                    float uW = dot(float2(uInterp.x, uInterp.y), vbCoords.xy) + uInterp.z;
                    float vW = dot(float2(vInterp.x, vInterp.y), vbCoords.xy) + vInterp.z;

                    float2 uv = float2(uW, vW) * w;

                    const uint diffuseID = GetBatchIdFromTriData(triangleData) * TEXTURES_PER_MESH;
                    BeginNonUniformResourceIndex(diffuseID, MAX_TEXTURE_UNITS);
                        diffuseColor = SampleLvlTex2D(gAllTextures[diffuseID], gSamplerTrilinearWrap, uv, lod);
                    EndNonUniformResourceIndex();
                    visible = diffuseColor.a > 0.5f;
                }
#endif

                if (visible)
                {
                    float depth = max((zInterp.x * vbCoords.x) + (zInterp.y * vbCoords.y) + zInterp.z, 0.0f);
                    
                    uint64_t packedDepthVBId = packDepthVBId(depth, triangleData);
                    // using accurate pixelCoord causes more artifacts, casting from the used vbcoords results in fewer artifacts
                    uint index = VisibilityBufferOffset(gRenderTargetInfo.view, viewportSize.x, int(vbCoords.x), int(vbCoords.y)); 
                    AtomicMaxU64(gVisibilityBufferRW[index], packedDepthVBId);
                }
            }
        }
    }

    RETURN();
}

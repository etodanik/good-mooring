#include "Resources.h.fsl"
#include "Global.srt.h"

STRUCT(VSInput)
{
    DATA(float4, Position, POSITION);
    DATA(float4, Normal, NORMAL);
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float4, Color, COLOR);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In, SV_InstanceID(uint) InstanceID)
{
    INIT_MAIN;
    VSOutput Out;

    float4x4 toWorld = gHandJointData.toWorld[InstanceID];
#if FT_MULTIVIEW
    float4x4 mvp = mul(gHandJointData.mvp[VR_VIEW_ID], toWorld);
#else
    float4x4 mvp = mul(gHandJointData.mvp, toWorld);
#endif

    Out.Position = mul(mvp, float4(In.Position.xyz, 1.0f));

    float3 normal = normalize(mul(toWorld, float4(In.Normal.xyz, 0.0f)).xyz);
    float3 lightDir = normalize(float3(0.3f, 0.7f, 0.5f));
    float  ndl = max(dot(normal, lightDir), 0.0f);
    Out.Color = float4(gHandJointData.color.rgb * (0.4f + 0.6f * ndl), gHandJointData.color.a);

    RETURN(Out);
}

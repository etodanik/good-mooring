#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

#define GEN_DISPATCH_THREADS 64

uint BucketIndexFromGroupCount(uint groupCount)
{
	uint bucket = 0u;
	for (uint bucketCandidate = 1u; bucketCandidate < MAX_NUM_DISPATCH_BUCKETS; ++bucketCandidate)
	{
		if ((groupCount & (1u << bucketCandidate)) != 0u)
		{
			bucket = bucketCandidate;
		}
	}
	return bucket;
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(GEN_DISPATCH_THREADS, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) threadID)
{
	INIT_MAIN;
	uint pipelineTile = threadID.x;
	uint numTiles = gPerFrameConstants.mNumTiles;
	uint numPipelineTiles = gPerFrameConstants.mNumPipelines * numTiles;
	if (pipelineTile >= numPipelineTiles)
	{
		RETURN();
	}

	uint pixelCount = gPixelCountPerPipelineTile[pipelineTile];
	if (pixelCount == 0u)
	{
		RETURN();
	}

	uint pipeline = pipelineTile / numTiles;
	// Records carry absolute bases in the sorted pixel list
	uint runBase = gPixelPipelineCountOffsets[pipeline] + gPixelOffsetPerPipelineTile[pipelineTile];
	uint groupsRemaining = pixelCount / COMPUTE_SHADE_GROUP_SIZE;
	uint pixelOffset = 0u;
	while (groupsRemaining > 0u)
	{
		uint bucketIndex = BucketIndexFromGroupCount(groupsRemaining);
		uint groupsInBucket = 1u << bucketIndex;
		uint pipelineBucket = pipeline * MAX_NUM_DISPATCH_BUCKETS + bucketIndex;
		uint recordInBucket = 0u;
		AtomicAdd(gDispatchIndirectArgs[pipelineBucket * 3u + 1u], 1u, recordInBucket);
		if (recordInBucket == 0u)
		{
			gDispatchIndirectArgs[pipelineBucket * 3u + 0u] = groupsInBucket;
			gDispatchIndirectArgs[pipelineBucket * 3u + 2u] = 1u;
		}

		uint recordBase = pipeline * MAX_NUM_DISPATCH_BUCKETS * gPerFrameConstants.mNumTiles +
		                  bucketIndex * gPerFrameConstants.mNumTiles;
		uint recordIndex = recordBase + recordInBucket;
		gDispatchOffsets[recordIndex] = runBase + pixelOffset;

		pixelOffset += groupsInBucket * COMPUTE_SHADE_GROUP_SIZE;
		groupsRemaining -= groupsInBucket;
	}
	RETURN();
}

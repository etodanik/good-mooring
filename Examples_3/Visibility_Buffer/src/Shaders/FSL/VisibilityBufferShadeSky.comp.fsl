// USERMACRO: SAMPLE_COUNT [1]
#include "VisibilityBufferResources.h.fsl"
#include "ShadeCompute.srt.h"

float2 ComputeScreenPosFromPixel(uint2 pixel)
{
	float2 pixelUv = (float2(pixel) + f2(0.5f)) * gPerFrameConstants.twoOverRes;
	return float2(pixelUv.x - 1.0f, 1.0f - pixelUv.y);
}

float3 ShadeSkyPixel(float2 screenPos)
{
#if defined(TARGET_QUEST) || defined(TARGET_HOLOLENS2)
	float4x4 invProjViewOrigin = gUniformCameraSky.invProjViewOrigin.mat[0];
#else
	float4x4 invProjViewOrigin = gUniformCameraSky.invProjViewOrigin.mat;
#endif
	float3 skyTexCoord = mul(invProjViewOrigin, float4(screenPos.x, screenPos.y, 1, 1)).xyz;
	return SampleLvlTexCube(gSkyboxTex, gSamplerBilinearWrap, skyTexCoord, 0.0f).xyz;
}

// Background fill for the compute path: the pixel-command lists only cover opaque geometry, so this pass writes
// the skybox into every pixel whose visibility buffer is empty. One thread per pixel over the full render area.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) threadID)
{
	INIT_MAIN;
	uint2 pixel = threadID.xy;
	if (pixel.x >= gPerFrameConstants.mRenderWidth || pixel.y >= gPerFrameConstants.mRenderHeight)
	{
		RETURN();
	}

	float4 visibilityRaw = LoadTex2D(gVBTex, gDepthSampler, pixel, 0);
	uint packedVisibility = packUnorm4x8(visibilityRaw);
	if (packedVisibility == ~0u)
	{
		float2 screenPos = ComputeScreenPosFromPixel(pixel);
		float3 skyColor = ShadeSkyPixel(screenPos);
		Write2D(gShadeOutput, int2(pixel), float4(skyColor, 1.0f));
	}
	RETURN();
}

#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"



ROOT_SIGNATURE(DefaultRootSignature)
#ifdef PRIMID_FALLBACK
PsOutVBPass PS_MAIN( PsInAlphaTested In )
#else
PsOutVBPass PS_MAIN( PsInAlphaTested In, SV_PrimitiveID(uint) primitiveID )
#endif
{
	INIT_MAIN;
	float4 texColor = f4(0);

    float alpha = 0.0f;


	const uint texID = In.meshIdx * TEXTURES_PER_MESH;

#ifdef ATLAS_FALLBACK

	uint diffuseSlice = gAtlasPlacementsBuffer[texID].mAtlasSlice;
	uint diffuseAtlasIndex = gAtlasPlacementsBuffer[texID].mAtlasIndex;
	float3 diffuseTexCoord = float3( In.texCoord, float(diffuseSlice) );
	BeginNonUniformResourceIndex(diffuseAtlasIndex, MAX_ATLAS_COUNT);
		alpha = SampleTex2DArray(gAtlasTextures[diffuseAtlasIndex], gTextureSampler, diffuseTexCoord).a;
	EndNonUniformResourceIndex();

#else

	BeginNonUniformResourceIndex(texID, MAX_TEXTURE_UNITS);
    	alpha = SampleTex2D(gAllTextures[texID], gTextureFilter, In.texCoord).a;
	EndNonUniformResourceIndex();

#endif

    clip(alpha - 0.5f);

	PsOutVBPass Out;
#ifdef PRIMID_FALLBACK
	Out.VBData = unpackUnorm4x8(PACK_VB_DATA(GEOMSET_ALPHA_CUTOUT, In.primitiveId));
#else
	Out.VBData = unpackUnorm4x8(PACK_VB_DATA(GEOMSET_ALPHA_CUTOUT, primitiveID));
#endif
#ifdef HANDLE_MULTIPLE_MATERIALS
	Out.MaterialID = float((gMeshConstantsBuffer[In.meshIdx].materialID_flags >> MATERIAL_ID_LOW_BIT) & MATERIAL_ID_MASK) / MATERIAL_ID_UNORM16_MAX;
#endif

	RETURN(Out);
}

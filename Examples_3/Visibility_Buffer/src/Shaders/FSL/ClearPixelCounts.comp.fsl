#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

#define CLEAR_THREADS 64

// Clear accumulated counters and reset the padding mask
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(CLEAR_THREADS, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) threadID)
{
	INIT_MAIN;
	uint clearIndex = threadID.y * LINEAR_DISPATCH_STRIDE_X + threadID.x;

	uint numTileMaterials = gPerFrameConstants.mNumTiles * gPerFrameConstants.mNumDispatchMaterials;
	uint numBucketSlots = gPerFrameConstants.mNumPipelines * MAX_NUM_DISPATCH_BUCKETS;
	uint numIndirectArgValues = numBucketSlots * 3u;
	if (clearIndex < numTileMaterials)
	{
		gPixelTileMaterialCountOffsets[clearIndex] = 0u; // CountPixels histogram, later reused as offset and cursor
	}
	if (clearIndex < numIndirectArgValues)
	{
		gDispatchIndirectArgs[clearIndex] = (clearIndex % 3u) == 2u ? 1u : 0u;
	}
	if (clearIndex < gPerFrameConstants.mPixelCommandMaskUintCount)
	{
		gPixelCommandPaddingMask[clearIndex] = 0xFFFFFFFFu;
	}
	RETURN();
}

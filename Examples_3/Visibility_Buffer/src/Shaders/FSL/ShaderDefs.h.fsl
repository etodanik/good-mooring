#ifndef _SHADER_DEFS_H
#define _SHADER_DEFS_H

// USERMACRO: SAMPLE_COUNT [1,2,4]
#ifndef SAMPLE_COUNT
    #define SAMPLE_COUNT 1
#endif

#define MAX_ATLAS_COUNT 48U


#define LIGHT_COUNT 128
#define LIGHT_SIZE 30.0f

#define LIGHT_CLUSTER_WIDTH 8
#define LIGHT_CLUSTER_HEIGHT 8

#define LIGHT_CLUSTER_COUNT_POS(ix, iy) ( ((iy)*LIGHT_CLUSTER_WIDTH)+(ix) )
#define LIGHT_CLUSTER_DATA_POS(il, ix, iy) ( LIGHT_CLUSTER_COUNT_POS(ix, iy)*LIGHT_COUNT + (il) )

//Override default VB geom sets
#define NUM_GEOMETRY_SETS 2          // 1 - opaque, 2 - alpha cutout
#define GEOMSET_OPAQUE 0
#define GEOMSET_ALPHA_CUTOUT 1

#ifndef MAX_TEXTURE_UNITS
#define MAX_TEXTURE_UNITS 1024U
#endif

#include "../../../../../Common_3/Resources/ResourceLoader/ResourceLoaderShared.h.fsl"
#include "../../../../../Common_3/Renderer/VisibilityBuffer/Shaders/FSL/VisibilityBufferStructs.h.fsl"

#define MAX_BLUR_KERNEL_SIZE 8

#define GODRAY_SCALE 2

#define GODRAY_STEPS 10

#define MSAA_STENCIL_MASK 1
#define VB_SHADE_TILE_COLUMNS 16
#define VB_SHADE_TILE_ROWS 8
#define VB_SHADE_TILE_COUNT (VB_SHADE_TILE_COLUMNS * VB_SHADE_TILE_ROWS)
#define MATERIAL_TILE_BIN_SIZE 32u
#define MATERIAL_ID_UNORM16_MAX 65535.0f
// Maximum number of distinct shade shaders the material system can route to
#define MAX_MATERIAL_SHADERS 32u
#ifndef MATERIAL_SHADER_ID
#define MATERIAL_SHADER_ID 0u
#endif
// Maximum number of materials the tile mask system supports; sizes the build pass groupshared bitmask.
// Keep >= the scene mesh count. 16384 -> 512 bins -> 2KB groupshared
#define MAX_MATERIAL_COUNT 16384u

// Fixed screen tile size in pixels so tile-relative pixel coords pack to 8 bits per axis
#define TILE_SIZE_PX 256u
#define TILE_SIZE_LOG2 8u
// Pixel runs are rounded to this size for material-uniform shade groups
#define COMPUTE_SHADE_GROUP_SIZE 64u
// Max distinct shade pipelines a material can route to
#define MAX_PIPELINES MAX_MATERIAL_SHADERS
// Number of raw material bins along the material axis of the (pipeline, tile, material) sort key
// The compute path requires gMeshCount <= MAX_DISPATCH_MATERIALS and uses materialID directly
#define MAX_DISPATCH_MATERIALS 512u
#define DISPATCH_MATERIAL_INVALID 0xFFFFFFFFu
// Powers of two buckets for indirect shade dispatches
#define MAX_NUM_DISPATCH_BUCKETS 11u

// Large 1D workloads are dispatched as 2D grids to stay under per dimension limits
#define LINEAR_DISPATCH_GROUPS_X 256u
#define LINEAR_DISPATCH_STRIDE_X (LINEAR_DISPATCH_GROUPS_X * 64u) // 16384 = X thread count

STRUCT(MeshConstants)
{
	DATA(uint, indexOffset, None);
	DATA(uint, vertexOffset, None);
	DATA(uint, materialID_flags, None);
	DATA(uint, baseColor, None);
	DATA(uint, specEmissiveStrength, None);
	DATA(uint, materialShaderID, None);
};

STRUCT(PerFrameConstantsData)
{
	DATA(float4, camPos, None);
	//========================================
	DATA(float4, lightDir, None);
	//========================================
	DATA(float4, lightColor, None);
	// TonemapInfo
    DATA(float, mLinearScale, None);
    DATA(uint, mOutputMode, None);
    DATA(uint, mMaxMaterialCount, None);
    DATA(uint, _pad0, None);
	//========================================
	DATA(float2, CameraPlane, None); //x : near, y : far
	DATA(uint, outputMode, None);
	DATA(float, mGodRayScatterFactor, None); // Godray scatter factor
	//========================================
	DATA(float2, twoOverRes, None);
	DATA(float, esmControl, None);
	DATA(uint, aoQuality, None);
	//========================================
	DATA(float2, frustumPlaneSizeNormalized, None);
	DATA(float2, depthTexSize, None);
	//========================================
	DATA(float, aoIntensity, None);
	DATA(uint, visualizeAo, None);
	//========================================
	DATA(float, godrayAttenuation, None);
	//========================================
	DATA(float, nearPlane, None);
	DATA(float, farPlane, None);
	//========================================
	DATA(uint, mNumDispatchMaterials, None); // raw material count this frame (<= MAX_DISPATCH_MATERIALS)
	DATA(uint, mNumPipelines, None);         // distinct shade pipelines in use (<= MAX_PIPELINES)
	DATA(uint, mNumTilesX, None);            // ceil(renderWidth  / TILE_SIZE_PX)
	//========================================
	DATA(uint, mNumTiles, None);             // mNumTilesX * ceil(renderHeight / TILE_SIZE_PX)
	DATA(uint, mRenderWidth, None);
	DATA(uint, mRenderHeight, None);
	DATA(uint, mPixelCommandMaskUintCount, None); // ceil(pixelCommandCount / 32); size of gPixelCommandPaddingMask
};


STRUCT(LightData)
{
	DATA(float4, position, None);
	DATA(float4, color, None);
};

STRUCT(GodRayRootConstantData)
{
	DATA(float, mScatterFactor, None);
};


// Godray blur: 
STRUCT(BlurRootConstantData)
{
	DATA(uint, mBlurPassType, None);
	DATA(uint, mFilterRadius, None);
};

// Per dispatch constant for the compute material sort shade pass
STRUCT(ShadeDispatchConstantData)
{
	DATA(uint, pipelineBucketIndex, None);
	DATA(uint, pad0, None);
	DATA(uint, pad1, None);
	DATA(uint, pad2, None);
};

// Skybox
STRUCT(UniformCameraSkyData)
{
	DATA(TFCameraMatrix, invProjViewOrigin, None);
};

// Resolve
STRUCT(ResolveConstantData)
{
	DATA(float, mSampleWeight, None);
};

#include "../../../../../Common_3/Renderer/VisibilityBuffer/Shaders/FSL/VisibilityBufferShaderDefs.h.fsl"

#endif

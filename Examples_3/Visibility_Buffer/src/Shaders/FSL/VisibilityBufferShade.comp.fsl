// USERMACRO: SAMPLE_COUNT [1]   (compute pixel-list path is single-sample)

// Enable wave-uniform texture indexing only for material-sorted compute shading.
#if defined(TARGET_ANDROID) || defined(ANDROID) || defined(TARGET_QUEST)
#define VB_SHADE_WAVE_UNIFORM_TEXTURES 0
#else
#define VB_SHADE_WAVE_UNIFORM_TEXTURES 1
#endif

#include "VisibilityBufferResources.h.fsl"
#include "ShadeCompute.srt.h"
#include "Shading.h.fsl"
#include "../../../../../Common_3/Renderer/VisibilityBuffer/Shaders/FSL/VisibilityBufferShadingUtilities.h.fsl"

float2 ComputeScreenPosFromPixel(uint2 pixel)
{
	float2 pixelUv = (float2(pixel) + f2(0.5f)) * gPerFrameConstants.twoOverRes;
	return float2(pixelUv.x - 1.0f, 1.0f - pixelUv.y);
}

bool ResolveComputeShadePixel(uint pipelineBucketIndex, uint3 threadID, out(uint2) pixel)
{
	pixel = uint2(0u, 0u);

	uint numTiles = gPerFrameConstants.mNumTiles;
	uint bucketIndex = pipelineBucketIndex % MAX_NUM_DISPATCH_BUCKETS;
	uint pipelineIndex = pipelineBucketIndex / MAX_NUM_DISPATCH_BUCKETS;
	uint recordBase = pipelineIndex * MAX_NUM_DISPATCH_BUCKETS * numTiles + bucketIndex * numTiles;
	uint recordIndex = recordBase + threadID.y;

	uint slot = gDispatchOffsets[recordIndex] + threadID.x;
	if ((gPixelCommandPaddingMask[slot >> 5u] & (1u << (slot & 31u))) != 0u)
	{
		return false;
	}

	uint command = gPixelCommands[slot];
	pixel = uint2(command & 0xFFFFu, command >> 16u);
	return pixel.x < gPerFrameConstants.mRenderWidth && pixel.y < gPerFrameConstants.mRenderHeight;
}

bool ShadeVisibilityPixel(uint2 pixel, float2 screenPos, out(float3) outColor)
{
	outColor = f3(0.0f);

	float4 visibilityRaw = LoadTex2D(gVBTex, gDepthSampler, pixel, 0);
	uint packedVisibility = packUnorm4x8(visibilityRaw);
	if (packedVisibility == ~0u)
	{
		return false;
	}

	uint primitiveID = (packedVisibility >> PRIM_ID_LOW_BIT) & PRIM_ID_MASK;
	uint geomSet = (packedVisibility >> GEOM_LOW_BIT) & GEOM_MASK;

	uint triangleIndex0 = INDEXBUFFER_OFFSET(geomSet) + (primitiveID * 3 + 0);
	uint triangleIndex1 = INDEXBUFFER_OFFSET(geomSet) + (primitiveID * 3 + 1);
	uint triangleIndex2 = INDEXBUFFER_OFFSET(geomSet) + (primitiveID * 3 + 2);

	uint index0 = LoadByte(gFilteredIndexBuffer, triangleIndex0 << 2);
	uint index1 = LoadByte(gFilteredIndexBuffer, triangleIndex1 << 2);
	uint index2 = LoadByte(gFilteredIndexBuffer, triangleIndex2 << 2);

	float3 vertexPos0 = asfloat(LoadByte4(gVertexPositionBuffer, index0 * 12)).xyz;
	float3 vertexPos1 = asfloat(LoadByte4(gVertexPositionBuffer, index1 * 12)).xyz;
	float3 vertexPos2 = asfloat(LoadByte4(gVertexPositionBuffer, index2 * 12)).xyz;

#if defined(TARGET_QUEST) || defined(TARGET_HOLOLENS2)
	float4x4 projection = gPerFrameVBConstants.transform[VIEW_CAMERA].projection.mat[0];
	float4x4 invVP = gPerFrameVBConstants.transform[VIEW_CAMERA].invVP.mat[0];
	float4x4 mvp = gPerFrameVBConstants.transform[VIEW_CAMERA].mvp.mat[0];
#else
	float4x4 projection = gPerFrameVBConstants.transform[VIEW_CAMERA].projection.mat;
	float4x4 invVP = gPerFrameVBConstants.transform[VIEW_CAMERA].invVP.mat;
	float4x4 mvp = gPerFrameVBConstants.transform[VIEW_CAMERA].mvp.mat;
#endif
	float4x4 projInv = InverseProjectionMatrixPerspectiveReverseZ(projection);
	float4x4 viewInv = mul(invVP, projection);

	float4 clipPos0 = mul(mvp, float4(vertexPos0, 1.0f));
	float4 clipPos1 = mul(mvp, float4(vertexPos1, 1.0f));
	float4 clipPos2 = mul(mvp, float4(vertexPos2, 1.0f));

	float4 worldPos0 = mul(invVP, clipPos0);
	float4 worldPos1 = mul(invVP, clipPos1);
	float4 worldPos2 = mul(invVP, clipPos2);

	float2 twoOverWindowSize = gPerFrameConstants.twoOverRes;

#if defined(USE_RAY_DIFFERENTIALS)
	BarycentricDeriv derivativesOut =
		CalcRayBary(worldPos0.xyz, worldPos1.xyz, worldPos2.xyz, screenPos, gPerFrameConstants.camPos.xyz, viewInv, projInv, twoOverWindowSize);
#else
	BarycentricDeriv derivativesOut = CalcFullBary(clipPos0, clipPos1, clipPos2, screenPos, twoOverWindowSize);
#endif

	f3x2 texCoords = make_f3x2_cols(
		unpack2Floats(LoadByte(gVertexTexCoordBuffer, index0 << 2)),
		unpack2Floats(LoadByte(gVertexTexCoordBuffer, index1 << 2)),
		unpack2Floats(LoadByte(gVertexTexCoordBuffer, index2 << 2)));

	float viewW = dot(float3(clipPos0.w, clipPos1.w, clipPos2.w), derivativesOut.m_lambda);
	float viewZ = viewW * getElem(projection, 2, 2) + getElem(projection, 3, 2);
	float3 position = mul(invVP, float4(screenPos * viewW, viewZ, viewW)).xyz;

	uint meshIndex = gIndirectDataBuffer[index0];
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
	meshIndex = WaveReadLaneFirst(meshIndex);
#endif
	GradientInterpolationResults results = Interpolate2DWithDeriv(derivativesOut, texCoords);
	float2 texCoordDX = results.dx;
	float2 texCoordDY = results.dy;
	float2 texCoord = results.interp;

	float4 diffuseColor = BASE_COLOR_DEFAULT;
	float3 normalMap = NORMAL_DEFAULT;
	float roughness = ROUGHNESS_DEFAULT;
	float metallic = METALLIC_DEFAULT;

	const uint diffuseID = meshIndex * TEXTURES_PER_MESH;
	const uint normID = diffuseID + 1;
	const uint specID = diffuseID + 2;

	MeshConstants meshConstant = gMeshConstantsBuffer[meshIndex];
	uint flags = ((meshConstant.materialID_flags >> FLAG_LOW_BIT) & FLAG_MASK);

#ifdef ATLAS_FALLBACK
	AtlasPlacement diffPlacement = gAtlasPlacementsBuffer[diffuseID];
	AtlasPlacement normPlacement = gAtlasPlacementsBuffer[normID];
	AtlasPlacement specPlacement = gAtlasPlacementsBuffer[specID];

	uint diffuseAtlasIndex = diffPlacement.mAtlasIndex;
	uint normAtlasIndex = normPlacement.mAtlasIndex;
	uint specAtlasIndex = specPlacement.mAtlasIndex;

	float3 diffuseTexCoord = float3(texCoord, float(diffPlacement.mAtlasSlice));
	float3 normalTexCoord = float3(texCoord, float(normPlacement.mAtlasSlice));
	float3 specularTexCoord = float3(texCoord, float(specPlacement.mAtlasSlice));

	{
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
		diffuseColor = SampleGradTex2DArray(gAtlasTextures[diffuseAtlasIndex], gTextureSampler, diffuseTexCoord, texCoordDX, texCoordDY);
#else
		BeginNonUniformResourceIndex(diffuseAtlasIndex, MAX_ATLAS_COUNT);
		diffuseColor = SampleGradTex2DArray(gAtlasTextures[diffuseAtlasIndex], gTextureSampler, diffuseTexCoord, texCoordDX, texCoordDY);
		EndNonUniformResourceIndex();
#endif

		float4 normalMapData;
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
		normalMapData = SampleGradTex2DArray(gAtlasTextures[normAtlasIndex], gTextureSampler, normalTexCoord, texCoordDX, texCoordDY);
#else
		BeginNonUniformResourceIndex(normAtlasIndex, MAX_ATLAS_COUNT);
		normalMapData = SampleGradTex2DArray(gAtlasTextures[normAtlasIndex], gTextureSampler, normalTexCoord, texCoordDX, texCoordDY);
		EndNonUniformResourceIndex();
#endif
		normalMap = unpack_normal(normalMapData.ba);

		float4 specularColor;
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
		specularColor = SampleGradTex2DArray(gAtlasTextures[specAtlasIndex], gTextureSampler, specularTexCoord, texCoordDX, texCoordDY);
#else
		BeginNonUniformResourceIndex(specAtlasIndex, MAX_ATLAS_COUNT);
		specularColor = SampleGradTex2DArray(gAtlasTextures[specAtlasIndex], gTextureSampler, specularTexCoord, texCoordDX, texCoordDY);
		EndNonUniformResourceIndex();
#endif

		roughness = specularColor.a;
		metallic = specularColor.b;
	}
#else
	if (FLAG_IS_VALID(flags, MATERIAL_FLAG_BASE_COLOR_TEX))
	{
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
		diffuseColor = SampleGradTex2D(gAllTextures[diffuseID], gSamplerAnisotropic, texCoord, texCoordDX, texCoordDY);
#else
		BeginNonUniformResourceIndex(diffuseID, MAX_TEXTURE_UNITS);
		diffuseColor = SampleGradTex2D(gAllTextures[diffuseID], gSamplerAnisotropic, texCoord, texCoordDX, texCoordDY);
		EndNonUniformResourceIndex();
#endif
	}
	else
	{
		diffuseColor = unpackR8G8B8A8(meshConstant.baseColor);
	}

	if (FLAG_IS_VALID(flags, MATERIAL_FLAG_NORMAL_TEX))
	{
		float4 normalMapData;
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
		normalMapData = SampleGradTex2D(gAllTextures[normID], gTextureSampler, texCoord, texCoordDX, texCoordDY);
#else
		BeginNonUniformResourceIndex(normID, MAX_TEXTURE_UNITS);
		normalMapData = SampleGradTex2D(gAllTextures[normID], gTextureSampler, texCoord, texCoordDX, texCoordDY);
		EndNonUniformResourceIndex();
#endif
		normalMap = unpack_normal(normalMapData.ba);
	}

	if (FLAG_IS_VALID(flags, MATERIAL_FLAG_SPEC_TEX))
	{
		float4 specularColor;
#if VB_SHADE_WAVE_UNIFORM_TEXTURES
		specularColor = SampleGradTex2D(gAllTextures[specID], gTextureSampler, texCoord, texCoordDX, texCoordDY);
#else
		BeginNonUniformResourceIndex(specID, MAX_TEXTURE_UNITS);
		specularColor = SampleGradTex2D(gAllTextures[specID], gTextureSampler, texCoord, texCoordDX, texCoordDY);
		EndNonUniformResourceIndex();
#endif
		roughness = specularColor.a;
		metallic = specularColor.b;
	}
	else
	{
		float2 specUnpacked = unpackR8G8(meshConstant.specEmissiveStrength >> 16);
		roughness = specUnpacked.x;
		metallic = specUnpacked.y;
	}
#endif

#if defined(ENABLED_GODRAY)
	float3 godrayColor = SampleLvlTex2D(gGodRayTexture, gTextureSampler, screenPos.xy * float2(0.5, -0.5) + 0.5, 0).rgb;
	godrayColor *= gPerFrameConstants.lightColor.rgb * gPerFrameConstants.godrayAttenuation * (1.0 / GODRAY_STEPS);
#endif

	float3x3 normals = make_f3x3_rows(
		decodeDir(unpackUnorm2x16(LoadByte(gVertexNormalBuffer, index0 << 2))),
		decodeDir(unpackUnorm2x16(LoadByte(gVertexNormalBuffer, index1 << 2))),
		decodeDir(unpackUnorm2x16(LoadByte(gVertexNormalBuffer, index2 << 2))));
	float3 normal = normalize(InterpolateWithDeriv_float3x3(derivativesOut, normals));

	f3x3 worldPositions = make_f3x3_cols(worldPos0.xyz, worldPos1.xyz, worldPos2.xyz);
	DerivativesOutput worldPosDerivatives = Cal3DDeriv(derivativesOut, worldPositions);
	DerivativesOutput uvDerivatives = { float3(results.dx, 0.0), float3(results.dy, 0.0) };
	normal = perturb_normal(normalMap, normal, worldPosDerivatives, uvDerivatives);

#if USE_AMBIENT_OCCLUSION
	float ao = calculateAoContrib(
		gPerFrameConstants.depthTexSize,
		gPerFrameConstants.aoIntensity,
		gPerFrameConstants.aoQuality,
		gPerFrameConstants.CameraPlane.y,
		gPerFrameConstants.CameraPlane.x,
		gPerFrameConstants.frustumPlaneSizeNormalized,
		float2(pixel),
		gDepthTex,
		gDepthSampler);
#else
	float ao = 1.0f;
#endif

	bool isTwoSided = FLAG_IS_VALID(flags, MATERIAL_FLAG_TWO_SIDED);
	float3 viewVec = normalize(gPerFrameConstants.camPos.xyz - position);
	float NoV = dot(normal, viewVec);
	if (isTwoSided && NoV < 0.0f)
	{
		normal = -normal;
		NoV = dot(normal, viewVec);
	}

	float3 halfVec = normalize(viewVec - gPerFrameConstants.lightDir.xyz);
	NoV = saturate(NoV);
	float NoL = dot(normal, -gPerFrameConstants.lightDir.xyz);
	NoL = (isTwoSided ? abs(NoL) : saturate(NoL));

	float3 reflectance0 = f3(0.08);
	float3 specularColor = lerp(reflectance0, diffuseColor.rgb, metallic);
	float3 diffuseColorPBR = lerp(diffuseColor.rgb, f3(0.0), metallic);

#if defined(TARGET_QUEST) || defined(TARGET_HOLOLENS2)
	float4 shadowPos = mul(gPerFrameVBConstants.transform[VIEW_SHADOW].vp.mat[0], float4(position, 1.0f));
#else
	float4 shadowPos = mul(gPerFrameVBConstants.transform[VIEW_SHADOW].vp.mat, float4(position, 1.0f));
#endif
	float shadowFactor = calcESMShadowFactor(shadowPos, gShadowMap, gDepthSampler, gPerFrameConstants.esmControl);

	float3 shadedColor = PBR_shadowFactor(NoL, NoV, viewVec, halfVec, normal, diffuseColorPBR, specularColor, roughness, metallic, shadowFactor);
	shadedColor *= gPerFrameConstants.lightColor.rgb * gPerFrameConstants.lightColor.a * NoL * shadowFactor;

	if (gPerFrameConstants.visualizeAo > 0)
	{
		shadedColor = f3(ao);
	}

	uint2 clusterCoords = uint2(floor((screenPos * 0.5f + 0.5f) * float2(LIGHT_CLUSTER_WIDTH, LIGHT_CLUSTER_HEIGHT)));
	uint numLightsInCluster = LoadByte(gLightClustersCount, LIGHT_CLUSTER_COUNT_POS(clusterCoords.x, clusterCoords.y) << 2);
	for (uint lightIndex = 0; lightIndex < numLightsInCluster; ++lightIndex)
	{
		uint lightId = LoadByte(gLightClusters, LIGHT_CLUSTER_DATA_POS(lightIndex, clusterCoords.x, clusterCoords.y) << 2);
		shadedColor += calcPointLightShade(
			NoV, viewVec, normal,
			diffuseColorPBR, specularColor, roughness, metallic,
			position, gLights[lightId].position.xyz, gLights[lightId].color.xyz, LIGHT_SIZE,
			isTwoSided);
	}

	float ambientIntensity = 0.05f * ao;
	float3 ambient = diffuseColor.rgb * ambientIntensity;
	float3 finalColor = shadedColor + ambient;
#if defined(ENABLED_GODRAY)
	finalColor += godrayColor;
#endif

	outColor = finalColor;
	return true;
}

// One thread per pixel command; writes lit color to gShadeOutput.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1) // must equal COMPUTE_SHADE_GROUP_SIZE
void CS_MAIN(SV_DispatchThreadID(uint3) threadID)
{
	INIT_MAIN;

	uint2 pixel;
#if defined(TARGET_ANDROID)
	// Android recovers the dispatch bucket from groupCountX instead of a PerDraw cbuffer.
	uint pipelineBucketIndex = MATERIAL_SHADER_ID * MAX_NUM_DISPATCH_BUCKETS + firstbithigh(GroupCountX());
#else
	uint pipelineBucketIndex = gShadeDispatchParams.pipelineBucketIndex;
#endif
	if (!ResolveComputeShadePixel(pipelineBucketIndex, threadID, pixel))
	{
		RETURN();
	}

	// Dispatches already contain pixels routed to this shader pipeline.
	float2 screenPos = ComputeScreenPosFromPixel(pixel);
	float3 color;
	if (ShadeVisibilityPixel(pixel, screenPos, color))
	{
		uint shaderHash = (uint(MATERIAL_SHADER_ID) + 1u) * 2654435761u;
		float3 tint = float3(
			float((shaderHash >> 0u) & 255u) / 255.0f,
			float((shaderHash >> 8u) & 255u) / 255.0f,
			float((shaderHash >> 16u) & 255u) / 255.0f);
		color = color * (0.45f + tint * 0.9f) + tint * 0.05f;
		Write2D(gShadeOutput, int2(pixel), float4(color, 1.0f));
	}
	RETURN();
}

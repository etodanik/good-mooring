#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

#if defined(HANDLE_MULTIPLE_MATERIALS) && !defined(ORBIS)
STRUCT(VSInput)
{
	DATA(uint, packedTileMaterial, POSITION);
};
#endif

STRUCT(VSOutput)
{
	DATA(float4, position, SV_Position);
	DATA(float2, screenPos, TEXCOORD0);
#if FT_MULTIVIEW
    DATA(FLAT(uint), ViewID, TEXCOORD3);
#endif
};

// Vertex shader
ROOT_SIGNATURE(DefaultRootSignature)
#ifndef HANDLE_MULTIPLE_MATERIALS
VSOutput VS_MAIN( SV_VertexID(uint) vertexId )
#elif defined(ORBIS)
VSOutput VS_MAIN( SV_VertexID(uint) vertexId, SV_InstanceID(uint) instanceId )
#else
VSOutput VS_MAIN( VSInput Input, SV_VertexID(uint) vertexId )
#endif
{
	INIT_MAIN;

	VSOutput result;
#ifndef HANDLE_MULTIPLE_MATERIALS
	// Produce a fullscreen triangle using the current vertexId
	// to automatically calculate the vertex porision. This
	// method avoids using vertex/index buffers to generate a
	// fullscreen quad.
	result.position.x = (vertexId == 2 ? 3.0 : -1.0);
	result.position.y = (vertexId == 0 ? -3.0 : 1.0);
	result.position.zw = float2(0, 1);
#else
	// Each instance is one present (tile, material) pair from this shader compacted region
#if defined(ORBIS)
	uint entry = gShadeQuadInstances[instanceId];
#else
	uint entry = Input.packedTileMaterial;
#endif
	uint tileIndex = entry >> 16u;
	uint materialID = entry & 0xFFFFu;

	uint tileX = tileIndex % VB_SHADE_TILE_COLUMNS;
	uint tileY = tileIndex / VB_SHADE_TILE_COLUMNS;

	float left = -1.0f + 2.0f * float(tileX) / float(VB_SHADE_TILE_COLUMNS);
	float right = -1.0f + 2.0f * float(tileX + 1u) / float(VB_SHADE_TILE_COLUMNS);
	float top = 1.0f - 2.0f * float(tileY) / float(VB_SHADE_TILE_ROWS);
	float bottom = 1.0f - 2.0f * float(tileY + 1u) / float(VB_SHADE_TILE_ROWS);

	uint corner = vertexId % 6u;
	float2 quadPos = float2(left, bottom);
	if (corner == 1u) { quadPos = float2(right, bottom); }
	else if (corner == 2u) { quadPos = float2(right, top); }
	else if (corner == 3u) { quadPos = float2(left, bottom); }
	else if (corner == 4u) { quadPos = float2(right, top); }
	else if (corner == 5u) { quadPos = float2(left, top); }

	result.position.x = quadPos.x;
	result.position.y = quadPos.y;
	result.position.z = float(materialID) / MATERIAL_ID_UNORM16_MAX;
	result.position.w = 1.0f;
#endif

	result.screenPos = result.position.xy;
#if FT_MULTIVIEW
	result.ViewID = VR_VIEW_ID;
#endif

	RETURN(result);
}

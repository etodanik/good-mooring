#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

// Prefix-sum level 1: material runs inside each pipeline, tile
#define SCAN_THREADS 256

GroupShared(uint, sPipelineTotals[MAX_PIPELINES]);
GroupShared(uint, sMaterialRounded[MAX_DISPATCH_MATERIALS]);
GroupShared(uint, sMaterialPipeline[MAX_DISPATCH_MATERIALS]);
GroupShared(uint, sMaterialOffset[MAX_DISPATCH_MATERIALS]);

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(SCAN_THREADS, 1, 1)
void CS_MAIN(SV_GroupID(uint3) groupID, SV_GroupThreadID(uint3) groupThreadID)
{
	INIT_MAIN;
	uint tile = groupID.x; // uniform across the group -> safe early out (no barrier divergence)
	uint numTiles = gPerFrameConstants.mNumTiles;
	if (tile >= numTiles)
	{
		RETURN();
	}

	uint numPipelines = gPerFrameConstants.mNumPipelines;
	uint numDispatchMaterials = gPerFrameConstants.mNumDispatchMaterials;
	uint threadIndex = groupThreadID.x;

	// Reset pipeline totals for this tile
	for (uint pipeline = threadIndex; pipeline < numPipelines; pipeline += SCAN_THREADS)
	{
		sPipelineTotals[pipeline] = 0u;
	}
	// Set material totals for the tile, rounding them up to the VB Shade compute group size for the uniform shading
	for (uint materialID = threadIndex; materialID < numDispatchMaterials; materialID += SCAN_THREADS)
	{
		uint count = gPixelTileMaterialCountOffsets[tile * numDispatchMaterials + materialID];
		uint rounded = (count + COMPUTE_SHADE_GROUP_SIZE - 1u) & ~(COMPUTE_SHADE_GROUP_SIZE - 1u);
		uint pipeline = min(gMeshConstantsBuffer[materialID].materialShaderID, numPipelines - 1u);
		sMaterialRounded[materialID] = rounded;
		sMaterialPipeline[materialID] = pipeline;
		sMaterialOffset[materialID] = 0u;
	}
	GroupMemoryBarrier();
	// Compute the rounded dispatch totals for the tile, pipeline, material in group shared
	for (uint materialID = threadIndex; materialID < numDispatchMaterials; materialID += SCAN_THREADS)
	{
		uint rounded = sMaterialRounded[materialID];
		if (rounded != 0u)
		{
			uint previous = 0u;
			AtomicAdd(sPipelineTotals[sMaterialPipeline[materialID]], rounded, previous);
			sMaterialOffset[materialID] = previous;
		}
	}
	GroupMemoryBarrier();
	// Store per-material tile-local offset
	for (uint materialID = threadIndex; materialID < numDispatchMaterials; materialID += SCAN_THREADS)
	{
		gPixelTileMaterialCountOffsets[tile * numDispatchMaterials + materialID] = sMaterialOffset[materialID];
	}
	// Store rounded pixel count per pipeline for the indirect VB Shade dispatches
	for (uint pipeline = threadIndex; pipeline < numPipelines; pipeline += SCAN_THREADS)
	{
		gPixelCountPerPipelineTile[pipeline * numTiles + tile] = sPipelineTotals[pipeline];
	}
	RETURN();
}

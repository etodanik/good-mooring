#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(1, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) threadID)
{
	INIT_MAIN;
	// Build indirect draw args and clear counts for the next material-tile pass.
	uint offset = 0u;
	for (uint shaderIndex = 0u; shaderIndex < MAX_MATERIAL_SHADERS; ++shaderIndex)
	{
		uint count = gShaderInstanceCounts[shaderIndex];
		gShaderInstanceCounts[shaderIndex] = 0u;
		gShaderInstanceCursors[shaderIndex] = offset;
		gShadeDrawArgs[shaderIndex * 4u + 0u] = 6u;
		gShadeDrawArgs[shaderIndex * 4u + 1u] = count;
		gShadeDrawArgs[shaderIndex * 4u + 2u] = 0u;
		gShadeDrawArgs[shaderIndex * 4u + 3u] = offset;
		offset += count;
	}
	RETURN();
}

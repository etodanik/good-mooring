#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"


ROOT_SIGNATURE(DefaultRootSignature)
#ifdef PRIMID_FALLBACK
PsOutVBPass PS_MAIN( PsInOpaque In )
{
    INIT_MAIN;
    PsOutVBPass Out;
    Out.VBData = unpackUnorm4x8( PACK_VB_DATA(GEOMSET_OPAQUE, In.primitiveId));
#ifdef HANDLE_MULTIPLE_MATERIALS
    Out.MaterialID = float((gMeshConstantsBuffer[In.meshIdx].materialID_flags >> MATERIAL_ID_LOW_BIT) & MATERIAL_ID_MASK) / MATERIAL_ID_UNORM16_MAX;
#endif
    RETURN(Out);
}
#else
PsOutVBPass PS_MAIN( PsInOpaque In, SV_PrimitiveID(uint) primitiveId )
{
    INIT_MAIN;
    PsOutVBPass Out;
    Out.VBData = unpackUnorm4x8( PACK_VB_DATA(GEOMSET_OPAQUE, primitiveId));
#ifdef HANDLE_MULTIPLE_MATERIALS
    Out.MaterialID = float((gMeshConstantsBuffer[In.meshIdx].materialID_flags >> MATERIAL_ID_LOW_BIT) & MATERIAL_ID_MASK) / MATERIAL_ID_UNORM16_MAX;
#endif
    RETURN(Out);
}
#endif

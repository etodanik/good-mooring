#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"
#include "VisibilityBufferResourcesUtil.h.fsl"

ROOT_SIGNATURE(DefaultRootSignature)
PsInAlphaTested VS_MAIN( SV_VertexID(uint) vertexID )
{
	INIT_MAIN;
	PsInAlphaTested Out;

    uint vertexIndex = vertexID;
    
#ifdef PRIMID_FALLBACK

   
#if defined(VULKAN) || defined (METAL)
        uint geomOffset = INDEXBUFFER_OFFSET(GEOMSET_ALPHA_CUTOUT);
        uint triOffset = 0;
#else
        uint geomOffset = 0;
        uint triOffset = INDEXBUFFER_OFFSET(GEOMSET_ALPHA_CUTOUT);
#endif

    Out.primitiveId = (vertexID - geomOffset ) / 3;
    uint triIdx0 = vertexID + triOffset;
    vertexIndex = LoadByte(gFilteredIndexBuffer, triIdx0 << 2);

#endif
    
    float4 vertexPos = LoadVertex(vertexIndex);

#if FT_MULTIVIEW
        Out.position = mul(gPerFrameVBConstants.transform[VIEW_CAMERA].mvp.mat[VR_VIEW_ID], vertexPos);
#else
        Out.position = mul(gPerFrameVBConstants.transform[VIEW_CAMERA].mvp.mat, vertexPos);
#endif

    Out.texCoord = LoadTexCoord(vertexIndex);
    // IndirectDataBuffer stores mesh index, which in this case is the same as material ID

	Out.meshIdx = gIndirectDataBuffer[vertexIndex]; 

    RETURN(Out);
}

#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

#define FINALIZE_THREADS 64

// Finalize each (tile,material) key to an absolute sorted list offset
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(FINALIZE_THREADS, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) threadID)
{
	INIT_MAIN;
	uint tileMaterialIndex = threadID.y * LINEAR_DISPATCH_STRIDE_X + threadID.x;
	uint numTiles = gPerFrameConstants.mNumTiles;
	uint numDispatchMaterials = gPerFrameConstants.mNumDispatchMaterials;
	uint numTileMaterials = numTiles * numDispatchMaterials;
	if (tileMaterialIndex >= numTileMaterials)
	{
		RETURN();
	}

	uint tileIndex = tileMaterialIndex / numDispatchMaterials;
	uint materialID = tileMaterialIndex - tileIndex * numDispatchMaterials;
	uint pipeline = min(gMeshConstantsBuffer[materialID].materialShaderID, gPerFrameConstants.mNumPipelines - 1u);
	uint pipelineTileIndex = pipeline * numTiles + tileIndex;
	uint absoluteOffset =
		gPixelPipelineCountOffsets[pipeline] + gPixelOffsetPerPipelineTile[pipelineTileIndex] + gPixelTileMaterialCountOffsets[tileMaterialIndex];
	gPixelTileMaterialCountOffsets[tileMaterialIndex] = absoluteOffset;
	RETURN();
}

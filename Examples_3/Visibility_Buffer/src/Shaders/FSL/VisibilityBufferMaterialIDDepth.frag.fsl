#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

STRUCT(PsIn)
{
	DATA(float4, position, SV_Position);
	DATA(float2, texCoord, TEXCOORD);
#if FT_MULTIVIEW
    DATA(FLAT(uint), ViewID, TEXCOORD3);
#endif
};

STRUCT(PsOut)
{
	DATA(float, depth, SV_Depth);
};

ROOT_SIGNATURE(DefaultRootSignature)
PsOut PS_MAIN(PsIn In, SV_SampleIndex(uint) sampleIndex)
{
	INIT_MAIN;
	PsOut Out;
#if (SAMPLE_COUNT > 1)
#if FT_MULTIVIEW
	Out.depth = LoadTex2DArrayMS(gMaterialIDTex, gDepthSampler, uint3(In.position.xy, In.ViewID), sampleIndex).r;
#else
	Out.depth = LoadTex2DMS(gMaterialIDTex, gDepthSampler, uint2(In.position.xy), sampleIndex).r;
#endif
#else
#if FT_MULTIVIEW
	Out.depth = LoadTex3D(gMaterialIDTex, gDepthSampler, uint3(In.position.xy, In.ViewID), 0).r;
#else
	Out.depth = LoadTex2D(gMaterialIDTex, gDepthSampler, uint2(In.position.xy), 0).r;
#endif
#endif /*SAMPLE_COUNT > 1*/
	RETURN(Out);
}

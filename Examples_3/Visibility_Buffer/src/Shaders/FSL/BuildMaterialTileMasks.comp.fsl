#include "VisibilityBufferResources.h.fsl"
#include "GLobal.srt.h"

#define MATERIAL_TILE_MASK_THREADS 256
#define MATERIAL_TILE_LOCAL_BIN_COUNT ((MAX_MATERIAL_COUNT + MATERIAL_TILE_BIN_SIZE - 1u) / MATERIAL_TILE_BIN_SIZE)

GroupShared(uint, gLocalMaterialBins[MATERIAL_TILE_LOCAL_BIN_COUNT]);

void AddMaterialToTile(uint materialID)
{
	uint previousBin = 0u;
	AtomicOr(gLocalMaterialBins[materialID / MATERIAL_TILE_BIN_SIZE], 1u << (materialID & (MATERIAL_TILE_BIN_SIZE - 1u)), previousBin);
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(MATERIAL_TILE_MASK_THREADS, 1, 1)
void CS_MAIN(SV_GroupThreadID(uint3) groupThreadID, SV_GroupID(uint3) groupID)
{
	INIT_MAIN;

	uint maxMaterialCount = min(gPerFrameConstants.mMaxMaterialCount, MAX_MATERIAL_COUNT);
	uint activeMaterialBinCount = min(uint((maxMaterialCount + MATERIAL_TILE_BIN_SIZE - 1u) / MATERIAL_TILE_BIN_SIZE), uint(MATERIAL_TILE_LOCAL_BIN_COUNT));

	for (uint clearBin = groupThreadID.x; clearBin < activeMaterialBinCount; clearBin += MATERIAL_TILE_MASK_THREADS)
	{
		gLocalMaterialBins[clearBin] = 0u;
	}

	GroupMemoryBarrier();

	uint2 renderSize = uint2(2.0f / gPerFrameConstants.twoOverRes);
	uint tileIndex = groupID.x;
	uint tileX = tileIndex % VB_SHADE_TILE_COLUMNS;
	uint tileY = tileIndex / VB_SHADE_TILE_COLUMNS;

	uint pixelMinX = (tileX * renderSize.x + VB_SHADE_TILE_COLUMNS - 1u) / VB_SHADE_TILE_COLUMNS;
	uint pixelMaxX = ((tileX + 1u) * renderSize.x + VB_SHADE_TILE_COLUMNS - 1u) / VB_SHADE_TILE_COLUMNS;
	uint pixelMinY = (tileY * renderSize.y + VB_SHADE_TILE_ROWS - 1u) / VB_SHADE_TILE_ROWS;
	uint pixelMaxY = ((tileY + 1u) * renderSize.y + VB_SHADE_TILE_ROWS - 1u) / VB_SHADE_TILE_ROWS;
	uint tileWidth = pixelMaxX - pixelMinX;
	uint tileHeight = pixelMaxY - pixelMinY;
	uint pixelCount = tileWidth * tileHeight;

	for (uint pixelIndex = groupThreadID.x; pixelIndex < pixelCount; pixelIndex += MATERIAL_TILE_MASK_THREADS)
	{
		uint2 pixel = uint2(pixelMinX + pixelIndex % tileWidth, pixelMinY + pixelIndex / tileWidth);
#if (SAMPLE_COUNT > 1)
		for (uint sampleIndex = 0u; sampleIndex < SAMPLE_COUNT; ++sampleIndex)
		{
#if FT_MULTIVIEW
			uint materialID = uint(LoadTex2DArrayMS(gMaterialIDTex, NO_SAMPLER, uint3(pixel, 0u), sampleIndex).r * MATERIAL_ID_UNORM16_MAX + 0.5f);
#else
			uint materialID = uint(LoadTex2DMS(gMaterialIDTex, NO_SAMPLER, pixel, sampleIndex).r * MATERIAL_ID_UNORM16_MAX + 0.5f);
#endif
			if (materialID < maxMaterialCount)
			{
				AddMaterialToTile(materialID);
			}
		}
#else
		uint materialID = uint(LoadTex2D(gMaterialIDTex, NO_SAMPLER, pixel, 0).r * MATERIAL_ID_UNORM16_MAX + 0.5f);
		if (materialID < maxMaterialCount)
		{
			AddMaterialToTile(materialID);
		}
#endif
	}

	GroupMemoryBarrier();

	uint tileMaterialBinOffset = tileIndex * activeMaterialBinCount;
	for (uint bin = groupThreadID.x; bin < activeMaterialBinCount; bin += MATERIAL_TILE_MASK_THREADS)
	{
		uint binMask = gLocalMaterialBins[bin];
		gMaterialTileMasks[tileMaterialBinOffset + bin] = binMask;
		for (uint bit = 0u; bit < MATERIAL_TILE_BIN_SIZE; ++bit)
		{
			if ((binMask & (1u << bit)) != 0u)
			{
				uint materialID = bin * MATERIAL_TILE_BIN_SIZE + bit;
				uint shaderIndex = min(gMeshConstantsBuffer[materialID].materialShaderID, MAX_MATERIAL_SHADERS - 1u);
				uint previousCount = 0u;
				AtomicAdd(gShaderInstanceCounts[shaderIndex], 1u, previousCount);
			}
		}
	}

	RETURN();
}

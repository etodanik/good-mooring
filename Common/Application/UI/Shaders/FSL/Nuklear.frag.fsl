#include "NuklearResources.h"
#include "../../../Fonts/Shaders/FSL/MSDF.h.fsl"

STRUCT(PS_INPUT)
{
	DATA(float4, pos, SV_Position);
	DATA(float4, col, COLOR0);
	DATA(float2, uv, TEXCOORD0);
	DATA(FLAT(uint), textureIndex, TEXCOORD1);
	DATA(FLAT(float), fontScale, TEXCOORD2);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( PS_INPUT In )
{
	INIT_MAIN;
	float4 Out = f4(0);

	// we convert from sRGB to linear after vertex stage, to make color more contrast for UI. (It's usual for editors)
	float gammaCoef = gUniformBlock.GammaCoef;
	float4 inputColor = float4(pow(In.col.r, gammaCoef), pow(In.col.g, gammaCoef), pow(In.col.b, gammaCoef), In.col.a);
#if SAMPLE_COUNT == 1
	uint texIdx = In.textureIndex & TEXTURE_INDEX_MASK;
	bool isFont = (In.textureIndex & TEXTURE_INDEX_FONT_BIT) != 0u;
	float4 s;
	BeginNonUniformResourceIndex(texIdx, MAX_BINDLESS_UI_TEXTURES);
		s = SampleTex2D(gTextures[texIdx], gSamplerBilinearClamp, In.uv.xy);
	EndNonUniformResourceIndex();
	if (isFont)
	{
		s = float4(1, 1, 1, calculateMSDF2D(s.rgb, In.fontScale));
	}
	Out = inputColor * s;
#else
	GetDimensionsMS(gTexture, texSize);
	uint2 coord = uint2(float2(texSize) * In.uv.xy);
	for (int s = 0; s < SAMPLE_COUNT; ++s)
	{
		Out += LoadTex2DMS(gTexture, gSamplerBilinearClamp, coord, s);
	}
	Out = inputColor * (Out / SAMPLE_COUNT);
#endif

	RETURN(Out);
}

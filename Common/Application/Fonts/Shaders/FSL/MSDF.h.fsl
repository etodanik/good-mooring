#ifndef MSDF_H_FSL
#define MSDF_H_FSL

float medianValue(float a, float b, float c)
{
    return max(min(a, b), min(max(a, b), c));
}

float screenPxRange(float pxRange, float2 uv, float2 textureSize)
{
    float2 unitRange = float2(pxRange, pxRange) / textureSize;
    float2 screenTexSize = float2(1.0, 1.0) / fwidth(uv);
    return max(0.5 * dot(unitRange, screenTexSize), 1.0);
}

float calculateMSDF2D(float3 data, float scale)
{
    float distance = medianValue(data.x, data.y, data.z) - 0.5;
    distance *= scale;
    return clamp(distance + 0.5, 0.0, 1.0);
}

float calculateMSDF3D(float3 data, float pxRange, float scale, float2 uv, float2 textureSize)
{
    float distance = medianValue(data.x, data.y, data.z) - 0.5;
    distance *= scale * screenPxRange(pxRange, uv, textureSize);
    return clamp(distance + 0.5, 0.0, 1.0);
}
#endif

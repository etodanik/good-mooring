STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
#ifdef GRID
    DATA(float4, LocalPos, TEXCOORD);
    DATA(float4, ViewPosAndFadeDist, POSITION);
#endif
    DATA(float4, Color, COLOR);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;

    #ifdef GRID
        float4 localPos = In.LocalPos;
        float coef = saturate(1.0 - length(localPos.xz));
        float distToCamera = length(In.ViewPosAndFadeDist.xyz);
        float fade = coef * (1.0 - min(1.0, distToCamera / In.ViewPosAndFadeDist.w));
        RETURN(float4(In.Color.xyz, fade * In.Color.w));
    #else
        RETURN(In.Color);
    #endif
}

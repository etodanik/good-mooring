transpile uint2 u2Sub(uint2 a, uint2 b) { return uint2(a.x - b.x, a.y - b.y); }
transpile uint2 u2Mul(uint2 a, uint2 b) { return uint2(a.x * b.x, a.y * b.y); }
transpile uint2 u2Div(uint2 a, uint2 b) { return uint2(a.x / b.x, a.y / b.y); }

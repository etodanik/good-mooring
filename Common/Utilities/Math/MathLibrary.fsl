transpile int3 i3Mul(int3 a, int3 b) { return int3(a.x * b.x, a.y * b.y, a.z * b.z); }
transpile int3 i3Div(int3 a, int3 b) { return int3(a.x / b.x, a.y / b.y, a.z / b.z); }
transpile int3 i3MulScalar(int3 a, int s) { return int3(a.x * s, a.y * s, a.z * s); }

#define PI 3.14159265358979323846

transpile quat   f4ToQuat(float4 f) { return quat(f.x, f.y, f.z, f.w); }
transpile float4 quatTof4(quat q) { return float4(q.x, q.y, q.z, q.w); }

transpile float2        f2Make(float x, float y) { return float2(x, y); }
transpile float3        f3Make(float x, float y, float z) { return float3(x, y, z); }

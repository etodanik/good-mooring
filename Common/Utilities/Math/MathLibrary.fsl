transpile uint4 u4Sub(uint4 a, uint4 b) { return uint4(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w); }
transpile uint4 u4Mul(uint4 a, uint4 b) { return uint4(a.x * b.x, a.y * b.y, a.z * b.z, a.w * b.w); }
transpile uint4 u4Div(uint4 a, uint4 b) { return uint4(a.x / b.x, a.y / b.y, a.z / b.z, a.w / b.w); }
transpile uint4 u4MulScalar(uint4 a, uint s) { return uint4(a.x * s, a.y * s, a.z * s, a.w * s); }
transpile uint4 u4DivScalar(uint4 a, uint s) { return uint4(a.x / s, a.y / s, a.z / s, a.w / s); }

transpile float f2LengthSqr(float2 a) { return a.x * a.x + a.y * a.y; }
transpile float f3LengthSqr(float3 a) { return a.x * a.x + a.y * a.y + a.z * a.z; }
transpile float f4LengthSqr(float4 a) { return a.x * a.x + a.y * a.y + a.z * a.z + a.w * a.w; }
transpile float quatLengthSqr(quat a) { return a.x * a.x + a.y * a.y + a.z * a.z + a.w * a.w; }

transpile float f2Length(float2 a) { return sqrt(f2LengthSqr(a)); }
transpile float f3Length(float3 a) { return sqrt(f3LengthSqr(a)); }
transpile float f4Length(float4 a) { return sqrt(f4LengthSqr(a)); }
transpile float quatLength(quat a) { return sqrt(quatLengthSqr(a)); }

transpile float2 f2Normalize(float2 a)
{
    float lenSqr = f2LengthSqr(a);
    if (lenSqr > 0.0)
    {
        float lenInv = 1.0 / sqrt(float(lenSqr));
        return float2(a.x * lenInv, a.y * lenInv);
    }
    return float2(0.0, 0.0);
}

transpile float3 f3Normalize(float3 a)
{
    float lenSqr = f3LengthSqr(a);
    if (lenSqr > 0.0)
    {
        float lenInv = 1.0 / sqrt(float(lenSqr));
        return float3(a.x * lenInv, a.y * lenInv, a.z * lenInv);
    }
    return float3(0.0, 0.0, 0.0);
}

transpile float4 f4Normalize(float4 a)
{
    float lenSqr = f4LengthSqr(a);
    if (lenSqr > 0.0)
    {
        float lenInv = 1.0 / sqrt(float(lenSqr));
        return float4(a.x * lenInv, a.y * lenInv, a.z * lenInv, a.w * lenInv);
    }
    return float4(0.0, 0.0, 0.0, 0.0);
}

transpile float f2Dot(float2 a, float2 b) { return a.x * b.x + a.y * b.y; }
transpile float f3Dot(float3 a, float3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
transpile float f4Dot(float4 a, float4 b) { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w; }
transpile float quatDot(quat a, quat b) { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w; }

transpile float fLerp(float a, float b, float t) { return a + (b - a) * t; }

transpile float2 f2Lerp(float2 a, float2 b, float t) { return f2Add(a, f2MulScalar(f2Sub(b, a), t)); }
transpile float3 f3Lerp(float3 a, float3 b, float t) { return f3Add(a, f3MulScalar(f3Sub(b, a), t)); }
transpile float4 f4Lerp(float4 a, float4 b, float t) { return f4Add(a, f4MulScalar(f4Sub(b, a), t)); }
transpile quat   quatLerp(quat a, quat b, float t) { return quatAdd(a, quatMulScalar(quatSub(b, a), t)); }

transpile float3 f3Cross(float3 a, float3 b)
{
    return float3(((a.y * b.z) - (a.z * b.y)), ((a.z * b.x) - (a.x * b.z)), ((a.x * b.y) - (a.y * b.x)));
}

transpile bool f3IsNormalizedEst(float3 v)
{
    float len = f3Length(v);
    return len >= (1 - 0.000001) && len <= (1 + 0.000001);
}

transpile f2x2 f2x2Identity()
{
    f2x2 m;
    m[0][0] = 1;
    m[1][1] = 1;

    m[0][1] = 0;
    m[1][0] = 0;

    return m;
}
transpile f3x3 f3x3Identity()
{
    f3x3 m;
    m[0][0] = 1;
    m[1][1] = 1;
    m[2][2] = 1;

    m[0][1] = 0;
    m[0][2] = 0;

    m[1][0] = 0;
    m[1][2] = 0;

    m[2][0] = 0;
    m[2][1] = 0;

    return m;
}
transpile f4x4 f4x4Identity()
{
    f4x4 m;
    m[0][0] = 1;
    m[1][1] = 1;
    m[2][2] = 1;
    m[3][3] = 1;

    m[0][1] = 0;
    m[0][2] = 0;
    m[0][3] = 0;

    m[1][0] = 0;
    m[1][2] = 0;
    m[1][3] = 0;

    m[2][0] = 0;
    m[2][1] = 0;
    m[2][3] = 0;

    m[3][0] = 0;
    m[3][1] = 0;
    m[3][2] = 0;

    return m;
}

transpile f2x2 f2x2InitRows(float E00, float E10, float E01, float E11)
{
    f2x2 m;

    m[0][0] = E00;
    m[1][0] = E10;

    m[0][1] = E01;
    m[1][1] = E11;

    return m;
}
transpile f3x3 f3x3InitRows(float E00, float E10, float E20, float E01, float E11, float E21, float E02, float E12, float E22)
{
    f3x3 m;

    m[0][0] = E00;
    m[1][0] = E10;
    m[2][0] = E20;
    m[0][1] = E01;
    m[1][1] = E11;
    m[2][1] = E21;
    m[0][2] = E02;
    m[1][2] = E12;
    m[2][2] = E22;

    return m;
}
transpile f4x4 f4x4InitRows(float E00, float E10, float E20, float E30, float E01, float E11, float E21, float E31, float E02, float E12,
                            float E22, float E32, float E03, float E13, float E23, float E33)
{
    f4x4 m;

    m[0][0] = E00;
    m[1][0] = E10;
    m[2][0] = E20;
    m[3][0] = E30;
    m[0][1] = E01;
    m[1][1] = E11;
    m[2][1] = E21;
    m[3][1] = E31;
    m[0][2] = E02;
    m[1][2] = E12;
    m[2][2] = E22;
    m[3][2] = E32;
    m[0][3] = E03;
    m[1][3] = E13;
    m[2][3] = E23;
    m[3][3] = E33;

    return m;
}

transpile float f2x2Determinant(f2x2 m) { return m[0][0] * m[1][1] - m[1][0] * m[0][1]; }

transpile float f3x3Determinant(f3x3 m)
{
    return m[0][0] * (m[1][1] * m[2][2] - m[2][1] * m[1][2]) - m[1][0] * (m[0][1] * m[2][2] - m[2][1] * m[0][2]) +
           m[2][0] * (m[0][1] * m[1][2] - m[1][1] * m[0][2]);
}

transpile float f4x4Determinant(f4x4 m)
{
    float det;

    f3x3 mSub;

    // first cofactor
    mSub[0] = float3(m[1][1], m[1][2], m[1][3]);
    mSub[1] = float3(m[2][1], m[2][2], m[2][3]);
    mSub[2] = float3(m[3][1], m[3][2], m[3][3]);
    det = m[0][0] * f3x3Determinant(mSub);

    // second cofactor
    mSub[0] = float3(m[0][1], m[0][2], m[0][3]);
    mSub[1] = float3(m[2][1], m[2][2], m[2][3]);
    mSub[2] = float3(m[3][1], m[3][2], m[3][3]);
    det -= m[1][0] * f3x3Determinant(mSub);

    // third cofactor
    mSub[0] = float3(m[0][1], m[0][2], m[0][3]);
    mSub[1] = float3(m[1][1], m[1][2], m[1][3]);
    mSub[2] = float3(m[3][1], m[3][2], m[3][3]);
    det += m[2][0] * f3x3Determinant(mSub);

    // fourth cofactor
    mSub[0] = float3(m[0][1], m[0][2], m[0][3]);
    mSub[1] = float3(m[1][1], m[1][2], m[1][3]);
    mSub[2] = float3(m[2][1], m[2][2], m[2][3]);
    det -= m[3][0] * f3x3Determinant(mSub);

    return det;
}

transpile f2x2 f2x2Transpose(f2x2 m)
{
    f2x2 t;
    t[0][0] = m[0][0];
    t[1][1] = m[1][1];

    t[0][1] = m[1][0];

    t[1][0] = m[0][1];

    return t;
}

transpile f3x3 f3x3Transpose(f3x3 m)
{
    f3x3 t;
    t[0][0] = m[0][0];
    t[1][1] = m[1][1];
    t[2][2] = m[2][2];

    t[0][1] = m[1][0];
    t[0][2] = m[2][0];

    t[1][0] = m[0][1];
    t[1][2] = m[2][1];

    t[2][0] = m[0][2];
    t[2][1] = m[1][2];

    return t;
}
transpile f4x4 f4x4Transpose(f4x4 m)
{
    f4x4 t;
    t[0][0] = m[0][0];
    t[1][1] = m[1][1];
    t[2][2] = m[2][2];
    t[3][3] = m[3][3];

    t[0][1] = m[1][0];
    t[0][2] = m[2][0];
    t[0][3] = m[3][0];

    t[1][0] = m[0][1];
    t[1][2] = m[2][1];
    t[1][3] = m[3][1];

    t[2][0] = m[0][2];
    t[2][1] = m[1][2];
    t[2][3] = m[3][2];

    t[3][0] = m[0][3];
    t[3][1] = m[1][3];
    t[3][2] = m[2][3];

    return t;
}

transpile f2x2 f2x2Mul(f2x2 a, f2x2 b)
{
    f2x2 at = f2x2Transpose(a);

    f2x2 c;

    c[0][0] = f2Dot(at[0], b[0]);
    c[0][1] = f2Dot(at[1], b[0]);
    c[1][0] = f2Dot(at[0], b[1]);
    c[1][1] = f2Dot(at[1], b[1]);

    return c;
}
transpile f3x3 f3x3Mul(f3x3 a, f3x3 b)
{
    f3x3 at = f3x3Transpose(a);

    f3x3 c;

    c[0][0] = f3Dot(at[0], b[0]);
    c[0][1] = f3Dot(at[1], b[0]);
    c[0][2] = f3Dot(at[2], b[0]);

    c[1][0] = f3Dot(at[0], b[1]);
    c[1][1] = f3Dot(at[1], b[1]);
    c[1][2] = f3Dot(at[2], b[1]);

    c[2][0] = f3Dot(at[0], b[2]);
    c[2][1] = f3Dot(at[1], b[2]);
    c[2][2] = f3Dot(at[2], b[2]);

    return c;
}
transpile f4x4 f4x4Mul(f4x4 a, f4x4 b)
{
    f4x4 at = f4x4Transpose(a);

    f4x4 c;

    c[0][0] = f4Dot(at[0], b[0]);
    c[0][1] = f4Dot(at[1], b[0]);
    c[0][2] = f4Dot(at[2], b[0]);
    c[0][3] = f4Dot(at[3], b[0]);

    c[1][0] = f4Dot(at[0], b[1]);
    c[1][1] = f4Dot(at[1], b[1]);
    c[1][2] = f4Dot(at[2], b[1]);
    c[1][3] = f4Dot(at[3], b[1]);

    c[2][0] = f4Dot(at[0], b[2]);
    c[2][1] = f4Dot(at[1], b[2]);
    c[2][2] = f4Dot(at[2], b[2]);
    c[2][3] = f4Dot(at[3], b[2]);

    c[3][0] = f4Dot(at[0], b[3]);
    c[3][1] = f4Dot(at[1], b[3]);
    c[3][2] = f4Dot(at[2], b[3]);
    c[3][3] = f4Dot(at[3], b[3]);

    return c;
}

transpile float2 f2x2Mulf2(f2x2 m, float2 v)
{
    float2 result;

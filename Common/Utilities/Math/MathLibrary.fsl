transpile float2 f2Add(float2 a, float2 b) { return float2(a.x + b.x, a.y + b.y); }
transpile float2 f2Sub(float2 a, float2 b) { return float2(a.x - b.x, a.y - b.y); }
transpile float2 f2Mul(float2 a, float2 b) { return float2(a.x * b.x, a.y * b.y); }
transpile float2 f2Div(float2 a, float2 b) { return float2(a.x / b.x, a.y / b.y); }
transpile float2 f2MulScalar(float2 a, float s) { return float2(a.x * s, a.y * s); }
transpile float2 f2DivScalar(float2 a, float s) { return float2(a.x / s, a.y / s); }

transpile float3 f3Add(float3 a, float3 b) { return float3(a.x + b.x, a.y + b.y, a.z + b.z); }
transpile float3 f3Sub(float3 a, float3 b) { return float3(a.x - b.x, a.y - b.y, a.z - b.z); }
transpile float3 f3Mul(float3 a, float3 b) { return float3(a.x * b.x, a.y * b.y, a.z * b.z); }
transpile float3 f3Div(float3 a, float3 b) { return float3(a.x / b.x, a.y / b.y, a.z / b.z); }
transpile float3 f3MulScalar(float3 a, float s) { return float3(a.x * s, a.y * s, a.z * s); }
transpile float3 f3DivScalar(float3 a, float s) { return float3(a.x / s, a.y / s, a.z / s); }

transpile float4 f4Add(float4 a, float4 b) { return float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w); }
transpile float4 f4Sub(float4 a, float4 b) { return float4(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w); }
transpile float4 f4Mul(float4 a, float4 b) { return float4(a.x * b.x, a.y * b.y, a.z * b.z, a.w * b.w); }
transpile float4 f4Div(float4 a, float4 b) { return float4(a.x / b.x, a.y / b.y, a.z / b.z, a.w / b.w); }
transpile float4 f4MulScalar(float4 a, float s) { return float4(a.x * s, a.y * s, a.z * s, a.w * s); }
transpile float4 f4DivScalar(float4 a, float s) { return float4(a.x / s, a.y / s, a.z / s, a.w / s); }

transpile quat quatAdd(quat a, quat b) { return quat(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w); }
transpile quat quatSub(quat a, quat b) { return quat(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w); }
transpile quat quatMul(quat q0, quat q1)
{
    return quat(q0.w * q1.x + q0.x * q1.w + q0.y * q1.z - q0.z * q1.y, q0.w * q1.y + q0.y * q1.w + q0.z * q1.x - q0.x * q1.z,
                q0.w * q1.z + q0.z * q1.w + q0.x * q1.y - q0.y * q1.x, q0.w * q1.w - q0.x * q1.x - q0.y * q1.y - q0.z * q1.z);
}
transpile quat quatDiv(quat a, quat b) { return quat(a.x / b.x, a.y / b.y, a.z / b.z, a.w / b.w); }
transpile quat quatMulScalar(quat a, float s) { return quat(a.x * s, a.y * s, a.z * s, a.w * s); }
transpile quat quatDivScalar(quat a, float s) { return quat(a.x / s, a.y / s, a.z / s, a.w / s); }


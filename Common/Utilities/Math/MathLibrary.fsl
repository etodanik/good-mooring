transpile uint3 u3Sub(uint3 a, uint3 b) { return uint3(a.x - b.x, a.y - b.y, a.z - b.z); }
transpile uint3 u3Mul(uint3 a, uint3 b) { return uint3(a.x * b.x, a.y * b.y, a.z * b.z); }
transpile uint3 u3Div(uint3 a, uint3 b) { return uint3(a.x / b.x, a.y / b.y, a.z / b.z); }
transpile uint3 u3MulScalar(uint3 a, uint s) { return uint3(a.x * s, a.y * s, a.z * s); }
transpile uint3 u3DivScalar(uint3 a, uint s) { return uint3(a.x / s, a.y / s, a.z / s); }


#ifndef _RESOURCE_LOADER_SHARED_H_FSL
#define _RESOURCE_LOADER_SHARED_H_FSL

#define MAX_TEXID                       0xFFFF
#define TEX_IDX_INVALID                 0xFFFF

#define TEXTURES_PER_MESH               3
#define MAX_ATLAS_COUNT                 48U

#define SPEC_BITSHIFT                   16
#define NORM_BITSHIFT                   32
#define GET_COLOR_TEXID(bundleID)       ((bundleID)&MAX_TEXID)
#define GET_SPEC_TEXID(bundleID)        (((bundleID) >> SPEC_BITSHIFT) & MAX_TEXID)
#define GET_NORMAL_TEXID(bundleID)      (((bundleID) >> NORM_BITSHIFT) & MAX_TEXID)

#define MATERIAL_ID_LOW_BIT             0  // 16 bits for materialID
#define FLAG_LOW_BIT                    16 // 16 bits for flags

#define MATERIAL_FLAG_NONE              0
#define MATERIAL_FLAG_TWO_SIDED         (1 << 0)
#define MATERIAL_FLAG_ALPHA_TESTED      (1 << 1)
#define MATERIAL_FLAG_TRANSPARENT       (1 << 2)
#define MATERIAL_FLAG_BASE_COLOR_TEX    (1 << 3)
#define MATERIAL_FLAG_SPEC_TEX          (1 << 4)
#define MATERIAL_FLAG_NORMAL_TEX        (1 << 5)
#define MATERIAL_FLAG_EMISSIVE          (1 << 6)
#define MATERIAL_FLAG_DOUBLE_VOXEL_SIZE (1 << 7)

// Needed for SDF generation
#define MATERIAL_FLAG_ALL \
    (MATERIAL_FLAG_TWO_SIDED | MATERIAL_FLAG_ALPHA_TESTED | MATERIAL_FLAG_TRANSPARENT | MATERIAL_FLAG_DOUBLE_VOXEL_SIZE)

#define FLAG_IS_VALID(x, flag) (((x) & (flag)) != 0)

#define BASE_COLOR_DEFAULT     float4(1.f, 1.f, 1.f, 1.f)
#define NORMAL_DEFAULT         float3(0.f, 0.f, 1.f)
#define ROUGHNESS_DEFAULT      1.f
#define METALLIC_DEFAULT       0.f
#define SPEC_DEFAULT           float2(ROUGHNESS_DEFAULT, METALLIC_DEFAULT)

#define MATERIAL_ID_MASK       0x0000FFFF // 0000 0000 0000 0000 1111 1111 1111 1111
#define FLAG_MASK              0x0000FFFF // 0000 0000 0000 0000 1111 1111 1111 1111

#endif

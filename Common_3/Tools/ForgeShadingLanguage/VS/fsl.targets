<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <ItemGroup>
        <PropertyPageSchema Include="
            $(MSBuildThisFileDirectory)fsl.xml;
            $(MSBuildThisFileDirectory)fsl_rules.xml
        "/>
        <AvailableItemName Include="FSLShader">
            <Targets>FSL</Targets>
        </AvailableItemName>
    </ItemGroup>

    <ItemDefinitionGroup>
        <FSLShader>
            <Verbose>false</Verbose>
            <Compile>true</Compile>
            <RootSignature>None</RootSignature>
        </FSLShader>
    </ItemDefinitionGroup>

    <Target Name="FSLClean" Condition="'@(FSLShader)' != ''" AfterTargets="Clean">
        <ItemGroup>
            <FSLShader>
                <Command>
                    if exist "%(FSLShader.OutDir)"\ (
                        rmdir /s /q "%(FSLShader.OutDir)"
                    )
                    if exist "%(FSLShader.BinaryOutDir)/%(FSLShader.Language)"\ (
                        rmdir /s /q "%(FSLShader.BinaryOutDir)/%(FSLShader.Language)"
                    )
                    if exist "%(FSLShader.BinaryOutDir)/reload-server.txt"\ (
                        del /q "%(FSLShader.BinaryOutDir)/reload-server.txt"
                    )
                    if exist "$(IntermediateOutputPath)/fsl_cmds"\ (
                        rmdir /s /q "$(IntermediateOutputPath)/fsl_cmds"
                    )
                    if exist "$(IntermediateOutputPath)/FSLAnalysis"\ (
                        rmdir /s /q "$(IntermediateOutputPath)/FSLAnalysis"
                    )
                    if exist "$(IntermediateOutputPath)/Headers"\ (
                        rmdir /s /q "$(IntermediateOutputPath)/Headers"
                    )
                    if exist "$(IntermediateOutputPath)/%(FSLShader.Language)"\ (
                        rmdir /s /q "$(IntermediateOutputPath)/%(FSLShader.Language)"
                    )
                </Command>
                <VerifyInputsAndOutputsExist>false</VerifyInputsAndOutputsExist>
                <Outputs>None</Outputs>
                <LinkObjects>false</LinkObjects>
            </FSLShader>
        </ItemGroup>
        <CustomBuild Condition=" '%(FSLShader.ExcludedFromBuild)' != 'true'" Sources="@(FSLShader)"/>
    </Target>

    <!-- build MathLibrary.fsl first -->
    <Target Name="FSL_MathLibrary" BeforeTargets="FSL">
        <ItemGroup>
            <FSLShader Include="@(FSLShader)" Condition="%(FSLShader.Filename)=='MathShaders'">
                <Command>
                    set PYTHON_PATH="$(MSBuildThisFileDirectory)../../../../Tools/python-3.6.0-embed-amd64/python"
                    %PYTHON_PATH% "$(MSBuildThisFileDirectory)/fsl_vs_call_helper.py" "$(WindowsSDK_ExecutablePath)" "%(FSLShader.OutDir)/" "%(FSLShader.BinaryOutDir)/" "%(Identity)" "%(FSLShader.Language)" "%(FSLShader.Compile)" "%(FSLShader.Verbose)" "$(Configuration)" "$(TargetOS)" "$(Platform)" "$(IntermediateOutputPath)/" "%(FSLShader.CPUHeaderDir)/" "%(FSLShader.ShaderHeaderDir)/" "%(FSLShader.Port)" "%(FSLShader.CacheArgs)"
                </Command>
                <VerifyInputsAndOutputsExist>false</VerifyInputsAndOutputsExist>
                <Outputs>None</Outputs>
                <LinkObjects>false</LinkObjects>
            </FSLShader>
        </ItemGroup>
        <CustomBuild Condition=" '%(FSLShader.ExcludedFromBuild)'!='true'" Sources="@(FSLShader)"/>
    </Target>

    <Target Name="FSL" DependsOnTargets="FSL_MathLibrary" Condition="'@(FSLShader)' != ''" BeforeTargets="ClCompile">
        <ItemGroup>
            <FSLShader Include="@(FSLShader)" Condition="%(FSLShader.Filename)!='MathShaders'">
                <Command>
                    set PYTHON_PATH="$(MSBuildThisFileDirectory)../../../../Tools/python-3.6.0-embed-amd64/python"
                    %PYTHON_PATH% "$(MSBuildThisFileDirectory)/fsl_vs_call_helper.py" "$(WindowsSDK_ExecutablePath)" "%(FSLShader.OutDir)/" "%(FSLShader.BinaryOutDir)/" "%(Identity)" "%(FSLShader.Language)" "%(FSLShader.Compile)" "%(FSLShader.Verbose)" "$(Configuration)" "$(TargetOS)" "$(Platform)" "$(IntermediateOutputPath)/" "%(FSLShader.CPUHeaderDir)/" "%(FSLShader.ShaderHeaderDir)/" "%(FSLShader.Port)" "%(FSLShader.CacheArgs)"
                </Command>
                <VerifyInputsAndOutputsExist>false</VerifyInputsAndOutputsExist>
                <Outputs>None</Outputs>
                <LinkObjects>false</LinkObjects>
            </FSLShader>
        </ItemGroup>
        <CustomBuild Condition=" '%(FSLShader.ExcludedFromBuild)'!='true'" Sources="@(FSLShader)"/>
    </Target>
  
  <PropertyGroup>
        <!-- 
            Trigger FSL always, we check internally for incremental rebuilds taking into account includes.
            Without this setting FSL is only triggered when some cpp changes.
            VS has another way to do this by specifying the input and output files of a target (for example: basic.vert.fsl -> basic.vert.bin) the problem is that there's no information about include files, we can't use it for our purposes.
        -->
        <DisableFastUpToDateCheck>True</DisableFastUpToDateCheck>
  </PropertyGroup>
</Project>

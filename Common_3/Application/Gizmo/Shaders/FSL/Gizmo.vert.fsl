#include "Gizmo.srt.h"

STRUCT(VSInput)
{
    DATA(float4, Position, POSITION);
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
#ifdef GRID
    DATA(float4, LocalPos, TEXCOORD);
    DATA(float4, ViewPosAndFadeDist, POSITION);
#endif
    DATA(float4, Color, COLOR);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In, SV_InstanceID(uint) InstanceID)
{
    INIT_MAIN;
    VSOutput Out;
    uint instanceIdx = InstanceID + gGizmoInstanceStart.mInstanceStart;
    float4x4 instanceM = gGizmoInstance[instanceIdx].mTRS;
    float4 instanceC = gGizmoInstance[instanceIdx].mColor;

#ifdef FRONT_FACE
    float3 globalPos = mul(instanceM, float4(0, 0, 0, 1)).xyz;
    float3 scale = mul(instanceM, float4(1, 1, 1, 0)).xyz;
    float3 localPos = mul(gUniformBlock.mCamera, float4(globalPos, 1)).xyz;
    localPos += float3(In.Position.x * scale.x, In.Position.y * scale.y, In.Position.z * scale.z) * localPos.z; 
    float4 cameraLocal = float4(localPos, 1);
    Out.Color = instanceC;
#endif

#ifdef GIZMO_LOCAL_INSTANCE
    float4 vert = In.Position;
    uint localInstanceIdx = asuint(vert.w);
    
    vert.w = 1;
    vert = mul(gGizmoLocalInstance[localInstanceIdx].mTRS, vert);
    vert = mul(instanceM, vert);

    float4 cameraLocal = mul(gUniformBlock.mCamera, vert); 
    Out.Color = gGizmoLocalInstance[localInstanceIdx].mColor;
#endif

#ifdef DEFAULT
    float4 worldGlobal = mul(instanceM, float4(In.Position.xyz, 1)); 
    float4 cameraLocal = mul(gUniformBlock.mCamera, worldGlobal); 

    Out.Color = instanceC;
#endif

#ifdef GRID
    float fadeDist = instanceM[3].w;
    instanceM[3].w = 1.0;
    float4 worldGlobal = mul(instanceM, float4(In.Position.xyz, 1)); 
    float4 cameraLocal = mul(gUniformBlock.mCamera, worldGlobal); 
    
    Out.LocalPos = In.Position;
    Out.ViewPosAndFadeDist = float4(cameraLocal.xyz, fadeDist);
    Out.Color = instanceC;
#endif

    Out.Position = mul(gUniformBlock.mProjection, cameraLocal);

    RETURN(Out);
}

#include "Font.srt.h"
#include "MSDF.h.fsl"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float4, Color, COLOR);
    DATA(float4, Texcoord, TEXCOORD0);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    float3 msdf = SampleLvlTex2D(gAtlas, gSamplerBilinearWrap, In.Texcoord.xy, 0 ).rgb;
    float alpha = 0;
    float scale = In.Texcoord.z;
    
#ifdef FONT_3D
    float2 textureSize = float2(GetDimensions(gAtlas, gSamplerBilinearWrap).xy);
    alpha = calculateMSDF3D(msdf, 1, scale, In.Texcoord.xy, textureSize);
#else
    alpha = calculateMSDF2D(msdf, scale);
#endif

    // to prevent overlapping by kerning
    if(alpha <= 0.0001)
    {
        discard;
    }

    float4 colorResult = float4(In.Color.rgb, alpha);
    RETURN(colorResult);
}